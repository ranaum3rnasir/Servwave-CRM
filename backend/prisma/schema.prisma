generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String                @id @default(uuid()) @db.Uuid
  email                       String                @unique
  password_hash               String                @default("")
  first_name                  String
  last_name                   String
  // SRVW-138: `role` is the BASE role. When custom_role_id is set the user's GRANTS come
  // from the custom role (lib/permissions/effectiveRole.ts grantRoleKey), but every code
  // branch asking "what kind of user is this" still reads `role`.
  role                        Role
  custom_role_id              String?               @db.Uuid
  custom_role                 CustomRole?           @relation(fields: [custom_role_id], references: [id], onDelete: SetNull)
  is_active                   Boolean               @default(true)
  has_login                   Boolean               @default(true)
  mfa_email_enrolled          Boolean               @default(false)
  enforce_clock_in_location   Boolean               @default(true)
  can_approve_clock_overrides Boolean               @default(false)
  phone                       String?
  phone_ext                   String?
  avatar_path                 String?               @db.Text
  department_id               String?               @db.Uuid
  location_id                 String?               @db.Uuid
  created_at                  DateTime              @default(now())
  updated_at                  DateTime              @updatedAt
  department                  Department?           @relation(fields: [department_id], references: [id], onDelete: SetNull)
  location                    Location?             @relation("UserLocation", fields: [location_id], references: [id], onDelete: SetNull)
  managed_locations           Location[]            @relation("LocationManager")
  headed_departments          Department[]          @relation("DepartmentHead")
  uploaded_attachments        Attachment[]          @relation("AttachmentUploadedBy")
  created_estimates           Estimate[]            @relation("EstimateCreatedBy")
  cancelled_walkthroughs      Walkthrough[]         @relation("WalkthroughCancelledBy")
  created_notes               Note[]                @relation("NoteCreatedBy")
  collected_payments          Payment[]             @relation("PaymentCollectedBy")
  timeline_events             TimelineEvent[]       @relation("TimelineCreatedBy")
  refunded_invoices           Invoice[]             @relation("InvoiceRefundedBy")
  table_preferences           UserTablePreference[]

  // --- Entity-redesign §8 money model (additive) ---
  issued_refunds  Refund[]  @relation("RefundRefundedBy")
  created_credits Credit[]  @relation("CreditCreatedBy")
  voided_payments Payment[] @relation("PaymentVoidedBy")

  // --- Emanuel inventory/comms unified back-relations ---
  primary_tech_locations    InventoryLocation[] @relation("LocationPrimaryTech")
  stock_movements_performed StockMovement[]     @relation("StockMovementActor")
  assigned_job_stages       JobStage[]          @relation("JobStageAssignedTech")
  requested_approvals       StockApproval[]     @relation("ApprovalRequestedByTech")
  reviewed_approvals        StockApproval[]     @relation("ApprovalReviewedBy")
  answered_calls            CallSession[]       @relation("CallSessionAgent")
  phone_agent               PhoneAgent?
  phone_numbers             UserPhoneNumber[]
  blocked_numbers_created   BlockedNumber[]     @relation("BlockedNumberBy")
  email_forward_rules       EmailForwardRule[]  @relation("ForwardRuleMember")
  // --- Email slice 8b/8c: thread assignment + per-user read state ---
  email_threads_assigned    EmailThread[]       @relation("EmailThreadAssignee")
  emails_sent               Email[]             @relation("EmailSentBy")
  email_read_states         EmailReadState[]    @relation("EmailReadStateUser")
  training_sessions         TrainingSession[]   @relation("TrainingSessionTrainee")
  assets_held               Asset[]             @relation("AssetAssignedUser")
  asset_events              AssetEvent[]        @relation("AssetEventUser")
  asset_events_acted        AssetEvent[]        @relation("AssetEventByUser")

  // --- Logistic Orders: four distinct actor seats on the same document ---
  logistic_orders_created   LogisticOrder[] @relation("LogisticOrderCreatedBy")
  logistic_orders_submitted LogisticOrder[] @relation("LogisticOrderSubmittedBy")
  logistic_orders_approved  LogisticOrder[] @relation("LogisticOrderApprovedBy")
  logistic_orders_processed LogisticOrder[] @relation("LogisticOrderProcessedBy")

  // --- Scheduler redesign: assignment M2M back-relations (additive) ---
  job_crew_memberships         JobAssignee[]              @relation("JobAssigneeUser")
  lead_crew_memberships        LeadAssignee[]             @relation("LeadAssigneeUser")
  walkthrough_crew_memberships LeadWalkthroughPerformer[] @relation("LeadWalkthroughPerformerUser")
  commission_owned_leads       Lead[]                     @relation("LeadCommissionOwner")
  created_jobs                 Job[]                      @relation("JobCreator")
  dispatched_jobs              Job[]                      @relation("JobDispatcher")
  jobs_as_salesperson          Job[]                      @relation("JobSalesperson")
  // --- Creator tracking back-relations (audit only; nothing reads them for authorization) ---
  created_leads                Lead[]                     @relation("LeadCreator")
  created_invoices             Invoice[]                  @relation("InvoiceCreator")
  created_customers            Customer[]                 @relation("CustomerCreator")
  created_payments             Payment[]                  @relation("PaymentCreator")
  created_attachments          Attachment[]               @relation("AttachmentCreator")
  // --- Service Plans ---
  service_plans_sold           ServicePlan[]              @relation("ServicePlanSoldBy")

  // --- Timeclock module ---
  time_entries         TimeEntry[]         @relation("TimeEntryUser")
  timeclock_ot_reviews TimeClockOtReview[] @relation("OtReviewUser")

  // --- Email-OTP 2FA ---
  mfa_email_challenges MfaEmailChallenge[] @relation("MfaChallengeUser")

  // --- Per-user permission overrides (allow/deny on top of the role grant) ---
  permission_overrides UserPermissionOverride[] @relation("UserPermissionOverrideUser")

  // --- Tasks module ---
  tasks_owned   Task[] @relation("TaskOwner")
  tasks_created Task[] @relation("TaskCreatedBy")

  // --- Automation Center ---
  automation_rules_created AutomationRule[] @relation("AutomationRuleCreatedBy")

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([custom_role_id])
  @@index([department_id])
  @@index([location_id])
  @@index([organization_id])
  @@map("users")
}

// --- Email-OTP 2FA ---
enum MfaChallengePurpose {
  LOGIN
  ENROLL
}

model MfaEmailChallenge {
  id                String              @id @default(uuid()) @db.Uuid
  user_id           String              @db.Uuid
  user              User                @relation("MfaChallengeUser", fields: [user_id], references: [id], onDelete: Cascade)
  code_hmac         String
  enc_refresh_token String? // null for ENROLL challenges
  purpose           MfaChallengePurpose @default(LOGIN)
  attempts          Int                 @default(0)
  expires_at        DateTime
  consumed_at       DateTime?
  created_at        DateTime            @default(now())

  @@index([user_id])
  @@index([expires_at])
  @@map("mfa_email_challenge")
}

model Department {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  head_id    String?  @db.Uuid // display-only manager; grants NO powers
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  users      User[]
  head       User?    @relation("DepartmentHead", fields: [head_id], references: [id], onDelete: SetNull)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, name])
  @@index([organization_id])
  @@index([head_id])
  @@map("departments")
}

model JobAssignee {
  id              String       @id @default(uuid()) @db.Uuid
  job_id          String       @db.Uuid
  user_id         String       @db.Uuid
  organization_id String       @db.Uuid
  created_at      DateTime     @default(now())
  job             Job          @relation(fields: [job_id], references: [id], onDelete: Cascade)
  user            User         @relation("JobAssigneeUser", fields: [user_id], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([job_id, user_id])
  @@index([user_id])
  @@index([organization_id])
  @@map("job_assignees")
}

model LeadAssignee {
  id              String       @id @default(uuid()) @db.Uuid
  lead_id         String       @db.Uuid
  user_id         String       @db.Uuid
  organization_id String       @db.Uuid
  created_at      DateTime     @default(now())
  lead            Lead         @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  user            User         @relation("LeadAssigneeUser", fields: [user_id], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([lead_id, user_id])
  @@index([user_id])
  @@index([organization_id])
  @@map("lead_assignees")
}

// Walkthrough-as-entity redesign. PR-A2 (2026-07-28) added walkthrough_id ADDITIVELY (nullable,
// backfilled) alongside the existing lead_id. PR-B2 (this migration: 20260729090000) completes the
// LOAD-BEARING half of the repoint: walkthrough_id is now required and the unique constraint keys
// on (walkthrough_id, user_id) instead of (lead_id, user_id), so the same performer can be assigned
// to a SECOND visit on the same lead (D1 - a lead has many walkthroughs; the old constraint
// rejected exactly that). lead_id itself is KEPT (not dropped) - every controller still reading
// Lead's `walkthrough_performers` back-relation (job/dashboard/estimate/attachment controllers)
// keeps working unmodified; PR-B2's own lead-controller code, which now cares which WALKTHROUGH a
// performer belongs to, reads/writes via walkthrough_id instead. lead_id, its FK, and those
// remaining call sites are removed together in PR-D2.
model LeadWalkthroughPerformer {
  id              String       @id @default(uuid()) @db.Uuid
  lead_id         String       @db.Uuid
  user_id         String       @db.Uuid
  organization_id String       @db.Uuid
  walkthrough_id  String       @db.Uuid
  created_at      DateTime     @default(now())
  lead            Lead         @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  user            User         @relation("LeadWalkthroughPerformerUser", fields: [user_id], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organization_id], references: [id])
  walkthrough     Walkthrough  @relation(fields: [walkthrough_id], references: [id], onDelete: Cascade)

  @@unique([walkthrough_id, user_id])
  @@index([user_id])
  @@index([organization_id])
  @@index([lead_id])
  @@map("lead_walkthrough_performers")
}

model Location {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  name            String   @db.VarChar(120)
  code            String?  @db.VarChar(20)
  address_line1   String?  @db.VarChar(200)
  address_line2   String?  @db.VarChar(200)
  city            String?  @db.VarChar(100)
  state           String?  @db.VarChar(50)
  postal_code     String?  @db.VarChar(20)
  country         String?  @default("US") @db.VarChar(2)
  timezone        String?  @db.VarChar(64)
  phone           String?  @db.VarChar(50)
  manager_id      String?  @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  manager      User?        @relation("LocationManager", fields: [manager_id], references: [id], onDelete: SetNull)
  members      User[]       @relation("UserLocation")

  @@unique([organization_id, code])
  @@index([organization_id])
  @@map("locations")
}

model Customer {
  id                  String   @id @default(uuid()) @db.Uuid
  customer_number     String   @db.VarChar(20)
  estimate_seq        Int      @default(0) // SERV10X-61 - per-customer estimate container counter (C00010-1)
  email               String?
  phone               String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  ad_source           String?
  allow_billing       Boolean  @default(false)
  company_name        String?
  first_name          String?
  last_name           String?
  phone_ext           String?
  secondary_phone     String?
  secondary_phone_ext String?
  tax_exempt          Boolean  @default(false)
  payment_type        String?

  // --- Entity-redesign §2/§10. Legacy fields above (ad_source, phone*, secondary_phone*, allow_billing, payment_type) are KEPT (deferred drop — FE-coupled / data-quality) ---
  kind                  CustomerKind
  segment               CustomerSegment
  parent_id             String?         @db.Uuid
  bill_to_customer_id   String?         @db.Uuid
  billing_address_line1 String?
  billing_address_line2 String?
  billing_city          String?
  billing_state         String?
  billing_zip           String?
  billing_terms         String?
  source                String?
  notes                 String?
  is_active             Boolean         @default(true)
  archived_at           DateTime?
  is_parent             Boolean         @default(false)
  // --- Custom Fields (SRVW-114): { "<definition-uuid>": <scalar> } ---
  custom_fields         Json            @default("{}")

  jobs              Job[]
  leads             Lead[]
  service_locations ServiceLocation[]
  extra_emails      CustomerEmail[]
  phones            CustomerPhone[]
  invoices          Invoice[]
  service_plans     ServicePlan[]
  // R6 (2026-07-22) — direct anchor mirroring Job.customer_id; see Estimate.customer_id.
  estimates         Estimate[]
  parent            Customer?         @relation("CustomerParent", fields: [parent_id], references: [id], onDelete: SetNull)
  members           Customer[]        @relation("CustomerParent")
  bill_to           Customer?         @relation("CustomerBillTo", fields: [bill_to_customer_id], references: [id], onDelete: SetNull)
  billed_customers  Customer[]        @relation("CustomerBillTo")

  // --- Emanuel comms/inventory unified back-relations ---
  membership_tier       String?
  sla_profile           String?
  call_sessions         CallSession[]
  message_threads       MessageThread[]
  whatsapp_chats        WhatsAppChat[]
  emails                Email[]
  contacts              Contact[]
  rfqs                  Rfq[]
  estimate_reservations EstimateReservation[]
  purchase_orders       PurchaseOrder[]
  job_stages            JobStage[]
  stock_approvals       StockApproval[]
  logistic_orders       LogisticOrder[]       @relation("LogisticOrderCustomer")

  // --- Creator tracking (audit only). NOTHING reads these for authorization. ---
  // Immutable, written once at create. Same shape and rationale as Job (see that model for the full
  // note): SetNull rather than Restrict so DELETE /api/users/:id/permanent stays possible, with
  // created_by_name as the snapshot that keeps the audit answer readable once the user row is gone,
  // and UNKNOWN as the honest default for the rows that predate the column.
  // -> md_files/specs/permissions/2026-08-04-technician-ownership-and-creator-tracking.md (Part A)
  created_by_id     String?         @db.Uuid
  created_by_name   String?
  created_by_source CreatedBySource @default(UNKNOWN)
  creator           User?           @relation("CustomerCreator", fields: [created_by_id], references: [id], onDelete: SetNull)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, customer_number])
  @@index([created_by_id])
  @@index([email])
  @@index([phone])
  @@index([organization_id])
  @@index([parent_id])
  @@index([bill_to_customer_id])
  @@map("customers")
}

model CustomerEmail {
  id          String   @id @default(uuid()) @db.Uuid
  customer_id String   @db.Uuid
  email       String   @db.VarChar(255)
  label       String?  @db.VarChar(50)
  // Does this secondary address receive the org's AUTOMATED customer mail (Automation
  // Center: walkthrough confirmation/reminder, job scheduled, ...)? The scalar
  // Customer.email always receives and has no equivalent flag. Manual sends (Send
  // Estimate / Send Invoice) still target the primary only — deliberately out of scope.
  // Defaults true so an address added from now on receives, matching the intent of
  // adding it; the migration backfills every PRE-EXISTING row to false so no live org
  // starts mailing an address nobody opted in. -> services/automations/recipients.ts
  receives_emails Boolean @default(true)
  created_at  DateTime @default(now())
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@map("customer_emails")
}

// Entity-redesign §2: 1+ phones per customer (label + extension). Reached via the
// parent Customer (already tenant-scoped) — no organization_id, mirrors CustomerEmail.
model CustomerPhone {
  id          String   @id @default(uuid()) @db.Uuid
  customer_id String   @db.Uuid
  phone       String
  label       String?  @db.VarChar(50)
  extension   String?
  is_primary  Boolean  @default(false)
  created_at  DateTime @default(now())
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@map("customer_phones")
}

model ServiceLocation {
  id            String        @id @default(uuid()) @db.Uuid
  customer_id   String        @db.Uuid
  address_line1 String
  address_line2 String?
  city          String
  state         String
  zip           String
  is_primary    Boolean       @default(false)
  created_at    DateTime      @default(now())
  // --- Entity-redesign §10: archive instead of delete when referenced ---
  is_active     Boolean       @default(true)
  archived_at   DateTime?
  jobs          Job[]
  leads         Lead[]
  service_plans ServicePlan[]
  // R6 (2026-07-22) — direct anchor mirroring Job.service_location_id; see Estimate.service_location_id.
  estimates     Estimate[]
  customer      Customer      @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@map("service_locations")
}

model Lead {
  id                           String           @id @default(uuid()) @db.Uuid
  lead_number                  String
  estimate_seq                 Int              @default(0) // SERV10X-61 - per-lead estimate container counter (L00005-1)
  customer_id                  String           @db.Uuid
  status                       LeadStatus       @default(NEW)
  service_request              String
  contacted_at                 DateTime?
  contacted_note               String?
  notes                        String?
  lost_at                      DateTime?
  lost_reason                  String?
  cancelled_at                 DateTime?
  cancelled_reason             String?
  created_at                   DateTime         @default(now())
  updated_at                   DateTime         @updatedAt
  job_type                     String?
  source                       String?
  scheduled_end                DateTime?
  scheduled_start              DateTime?
  // --- Entity-redesign §3: lead anchored to one ServiceLocation. service_address_* below are @deprecated — backfilled into ServiceLocation, then dropped in Phase D ---
  service_location_id          String?          @db.Uuid
  service_address_line1        String?
  service_address_line2        String?
  service_city                 String?
  service_state                String?
  service_zip                  String?
  // --- Custom Fields (SRVW-114): { "<definition-uuid>": <scalar> } ---
  custom_fields                Json              @default("{}")
  estimates                    Estimate[]
  call_sessions                CallSession[]    @relation("LeadCallSessions")
  message_threads              MessageThread[]  @relation("LeadMessageThreads")
  messages                     Message[]        @relation("LeadMessages")
  whatsapp_chats               WhatsAppChat[]   @relation("LeadWhatsAppChats")
  whatsapp_messages            WhatsAppMessage[] @relation("LeadWhatsAppMessages")
  emails                       Email[]          @relation("LeadEmails")
  lead_tags                    LeadTag[]
  customer                     Customer         @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  service_location             ServiceLocation? @relation(fields: [service_location_id], references: [id])

  // --- Scheduler redesign: assignment M2M spine (legacy assigned_to/walkthrough_assigned_to dropped in TG7) ---
  commission_owner_id                String?                    @db.Uuid
  commission_owner                   User?                      @relation("LeadCommissionOwner", fields: [commission_owner_id], references: [id])
  lead_assignees                     LeadAssignee[]
  walkthrough_performers             LeadWalkthroughPerformer[]
  // --- Logistic Orders ---
  logistic_orders                    LogisticOrder[]            @relation("LogisticOrderLead")

  // --- Walkthrough-as-entity redesign, PR-A2 (2026-07-28): table only, nothing reads it yet ---
  walkthroughs Walkthrough[]

  // --- Creator tracking (audit only). NOTHING reads these for authorization. ---
  // Immutable, written once at create. Same shape and rationale as Job - see that model. Distinct
  // from commission_owner_id above: the owner is reassignable and is about responsibility, this is
  // an unchanging record of who first made the row.
  // -> md_files/specs/permissions/2026-08-04-technician-ownership-and-creator-tracking.md (Part A)
  created_by_id     String?         @db.Uuid
  created_by_name   String?
  created_by_source CreatedBySource @default(UNKNOWN)
  creator           User?           @relation("LeadCreator", fields: [created_by_id], references: [id], onDelete: SetNull)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, lead_number])
  @@index([created_by_id])
  @@index([status])
  @@index([customer_id])
  @@index([service_location_id])
  @@index([commission_owner_id])
  @@index([organization_id])
  @@map("leads")
}

// Walkthrough-as-entity redesign, PR-A2 (spec md_files/specs/leads/2026-07-28-walkthrough-as-entity.md,
// plan md_files/plans/leads/2026-07-28-walkthrough-as-entity-phase-2.md): a lead has MANY walkthroughs
// (site visits), each with its own lifecycle - shaped on PlanVisit, the house template for a
// tenant-scoped child with its own status enum. Nothing reads this table yet in PR-A2; the nine
// Lead.walkthrough_* columns remain the source of truth until PR-B2 repoints reads/writes here and
// PR-D2 drops them.
model Walkthrough {
  id                     String            @id @default(uuid()) @db.Uuid
  organization_id        String            @db.Uuid
  lead_id                String            @db.Uuid
  status                 WalkthroughStatus @default(REQUESTED)
  scheduled_at           DateTime?
  duration_minutes       Int?
  completed_at           DateTime?
  notes                  String?
  cancelled_at           DateTime?
  cancelled_reason       String?
  cancelled_by           String?           @db.Uuid
  customer_email_sent_at DateTime?
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt

  lead         Lead                       @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  canceller    User?                      @relation("WalkthroughCancelledBy", fields: [cancelled_by], references: [id], onDelete: SetNull)
  organization Organization               @relation(fields: [organization_id], references: [id])
  performers   LeadWalkthroughPerformer[]

  @@index([lead_id])
  @@index([organization_id])
  @@index([organization_id, status])
  @@map("walkthroughs")
}

model Estimate {
  id                     String                    @id @default(uuid()) @db.Uuid
  // R6 (2026-07-22) — M5: lead_id relaxed to optional; customer_id/service_location_id added,
  // mirroring Job's own anchor shape exactly (Job.customer_id/service_location_id,
  // schema.prisma ~663-664). Backend-foundation-only stage: no create-time UI path exists yet
  // for a lead-less estimate — create()/duplicate()/revise() denormalize these two columns
  // from the lead at write time so every row (past and future, as long as creation stays
  // lead-anchored) has them populated. service_location_id stays nullable (unlike Job's
  // required column) because ~54% of existing leads have no ServiceLocation row yet (still on
  // the legacy service_address_* fields) — backfill coverage is incomplete, verified on staging.
  lead_id                String?                   @db.Uuid
  customer_id            String                    @db.Uuid
  service_location_id    String?                   @db.Uuid
  // R6 — M4: mirrors Job.estimate_id in the reverse direction (which estimate a job was
  // created from). Backfilled once from Job.estimate_id, then kept in sync at the one write
  // site (job.controller.ts create()) whenever a job's single-estimate provenance is set. Not
  // @unique: a future multi-estimate-per-job design (SERV10X-61) may want more than one estimate
  // pointing at the same job — no need to foreclose that here.
  job_id                 String?                   @db.Uuid
  estimate_number        String
  status                 EstimateStatus            @default(DRAFT)
  sent_at                DateTime?
  approved_at            DateTime?
  declined_at            DateTime?
  expired_at             DateTime?
  cancelled_at           DateTime?
  cancelled_reason       String?
  voided_at              DateTime?
  voided_reason          String?
  scope_notes            String?
  scopes                 Json?
  subtotal               Decimal                   @db.Decimal(12, 2)
  tax_amount             Decimal                   @db.Decimal(12, 2)
  total_amount           Decimal                   @db.Decimal(12, 2)
  public_token           String?                   @unique
  created_by             String                    @db.Uuid
  created_at             DateTime                  @default(now())
  updated_at             DateTime                  @updatedAt
  // R5c (2026-07-22) -- widened 5,4 -> 6,5: MN/MO/NJ/NM's real combined rates (6.875%/4.225%/
  // 6.625%/5.125%) need a 5th decimal place; (5,4) rounds them at the door.
  tax_rate               Decimal                   @default(0) @db.Decimal(6, 5)
  discount_type          DiscountType?
  discount_value         Decimal?                  @db.Decimal(12, 2)
  discount_name          String?
  discount_amount        Decimal                   @default(0) @db.Decimal(12, 2)
  signature_data         String?
  signature_ip           String?
  signature_at           DateTime?
  terms_accepted         Boolean                   @default(false) // #21 — server-enforced T&C acknowledgment
  terms_accepted_at      DateTime? // #21 — set together with terms_accepted
  valid_until            DateTime?
  snapshot_terms         String?                   @db.Text
  snapshot_notes         String?                   @db.Text
  snapshot_payment_terms String?                   @db.Text
  // ── S1 reporting fields (nullable; see report.controller.ts) ──
  lead_source            String?
  job_type               String?
  lost_reason            LostReason?
  // ── Estimate workspace redesign (2026-07-03) ──
  name                   String?
  version                Int                       @default(1)
  modified_after_send    Boolean                   @default(false)
  superseded_by_id       String?                   @unique @db.Uuid
  deposit_type           DepositDefaultType?
  deposit_value          Decimal?                  @db.Decimal(12, 2)
  // R3 (2026-07-21) — cost model: labor hours + a per-estimate overhead override (D2/D8/D18).
  // Nullable override mirrors deposit_type/deposit_value directly above: null = fall back to the
  // org default (Organization.overhead_mode/overhead_value). Cost/margin math itself is computed
  // on read (frontend), not persisted — these three columns are the only new state.
  labor_hours            Decimal?                  @db.Decimal(8, 2)
  overhead_mode          DepositDefaultType?
  overhead_value         Decimal?                  @db.Decimal(12, 2)
  scope_name             String?
  send_config            EstimateSendConfig?
  line_items             EstimateLineItem[]
  // R5f (2026-07-22) — scope-of-work photos. Estimate.scopes is a JSONB array with no relational
  // row per scope block, so this side carries the FK (compound estimate_id+scope_id match is
  // required at every read/write site — see EstimateScopePhoto's own comment).
  scope_photos           EstimateScopePhoto[]
  version_snapshots      EstimateVersionSnapshot[]
  creator                User                      @relation("EstimateCreatedBy", fields: [created_by], references: [id])
  lead                   Lead?                     @relation(fields: [lead_id], references: [id], onDelete: Restrict)
  customer               Customer                  @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  service_location       ServiceLocation?          @relation(fields: [service_location_id], references: [id])
  // "JobPrimaryEstimate" — the pre-existing 1:1 (Job.estimate_id, the job's own provenance
  // pointer, unchanged). "EstimateJobLink" — the new R6 mirror above (Estimate.job_id). Two
  // distinct relations between the same two models must both be explicitly named; this rename
  // is schema-only (the Prisma Client field names `job`/`job_link` are unaffected).
  job                    Job?                      @relation("JobPrimaryEstimate")
  job_link               Job?                      @relation("EstimateJobLink", fields: [job_id], references: [id], onDelete: SetNull)
  invoices               Invoice[]
  reservations           EstimateReservation[]
  superseded_by          Estimate?                 @relation("EstimateSupersession", fields: [superseded_by_id], references: [id])
  superseded_from        Estimate?                 @relation("EstimateSupersession")
  logistic_orders        LogisticOrder[]           @relation("LogisticOrderEstimate")

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, estimate_number])
  @@index([lead_id])
  @@index([customer_id])
  @@index([service_location_id])
  @@index([job_id])
  @@index([status])
  @@index([created_by])
  @@index([organization_id])
  @@map("estimates")
}

