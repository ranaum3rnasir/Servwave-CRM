// R5c (2026-07-22) -- org-level tax rate entry (port-plan §3.3's "org-level custom rates").
// 2026-08-05: every org now owns a full copy of the 52 global rows as well as any hand-made ones,
// so this table -- not StateTaxRate -- is the list an org's pickers read. StateTaxRate is reduced
// to seed source + fallback. Shape-compatible with StateTaxRate's {state_code, state_name, tax_rate}
// in the API response (state-tax-rate.controller.ts merges these in, giving a hand-made rate a
// synthetic `CUSTOM-<id>` code) so ReceiptCard.tsx's Select needs no changes.
model OrgTaxRate {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  name            String   @db.VarChar(100)
  rate            Decimal  @db.Decimal(6, 5)
  // Provenance of a row seeded from the global StateTaxRate list; NULL for a hand-made org rate.
  // The partial unique index keeps one seeded row per state per org while leaving hand-made rows
  // unbounded, since NULLs are distinct in a Postgres unique index.
  state_code      String?  @db.VarChar(2)
  // Show this rate in the estimate/invoice/job tax pickers. A UI filter only -- tax derivation
  // deliberately ignores it, so hiding a state can never silently under-charge an out-of-state job.
  is_visible      Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([organization_id, is_visible])
  @@map("org_tax_rates")
}

