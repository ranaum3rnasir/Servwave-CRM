// SRVW-138 - an org-defined role. Its `key` is written into RolePermission.role, the
// same column the four system role names use, so keys are validated against those
// (effectiveRole.ts isReservedRoleKey) and are immutable once created: changing a key
// would orphan every grant row pointing at it. Renames therefore touch `label` only.
//
// `base_role` is the system role whose CODE-level behaviour this role inherits - the
// value copied onto users.role. ADMIN is permitted: such a role is seeded with an
// explicit full grant set and deliberately skips the `manage all` short-circuit
// (effectiveRole.ts isSuperUser).
model CustomRole {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  key             String
  label           String
  description     String       @default("")
  base_role       Role
  archived_at     DateTime?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  users           User[]

  @@unique([organization_id, key])
  @@index([organization_id])
  @@map("custom_roles")
}

model RolePermission {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  role            String
  action          String
  subject         String
  conditions      Json?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, role, action, subject])
  @@index([organization_id, role])
  @@map("role_permissions")
}

// Per-user permission override (Phase 2 of the RBAC model). Layers on top of the
// user's role grant: `effect=allow` grants a capability the role lacks; `effect=deny`
// revokes a capability the role grants. Capability-level only (no row-scope) in v1.
// ADMIN is `manage all` in code and is never affected by overrides.
model UserPermissionOverride {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  user_id         String       @db.Uuid
  action          String
  subject         String
  effect          String // 'allow' | 'deny'
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user            User         @relation("UserPermissionOverrideUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, action, subject])
  @@index([user_id])
  @@index([organization_id])
  @@map("user_permission_overrides")
}

