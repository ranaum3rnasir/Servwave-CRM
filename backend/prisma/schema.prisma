// Append-only history ledger: no update/delete endpoint ever exists for
// asset_events (same stance as stock_movements).
model AssetEvent {
  id         String         @id @default(uuid()) @db.Uuid
  asset_id   String         @db.Uuid
  type       AssetEventType
  // Counterparty tech: new holder for ASSIGNED/TRANSFERRED; releasing holder
  // for RETURNED; holder-at-retire for RETIRED; null for NOTE.
  user_id    String?        @db.Uuid
  // Actor. Written on EVERY event (controller uses req.user!.id — never null at
  // write time). Nullable + SetNull ONLY so the history survives hard user
  // deletion — the exact stock_movements.actor_user_id precedent.
  by_user_id String?        @db.Uuid
  note       String?        @db.Text
  at         DateTime       @default(now())

  asset   Asset @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  user    User? @relation("AssetEventUser", fields: [user_id], references: [id], onDelete: SetNull)
  by_user User? @relation("AssetEventByUser", fields: [by_user_id], references: [id], onDelete: SetNull)

  organization_id String       @db.Uuid
