model Payment {
  id                       String             @id @default(uuid()) @db.Uuid
  invoice_id               String             @db.Uuid
  amount                   Decimal            @db.Decimal(12, 2)
  method                   PaymentMethod
  paid_at                  DateTime
  collected_by             String?            @db.Uuid
  stripe_payment_intent_id String?
  stripe_fee_amount             Decimal? @db.Decimal(12, 2)
  platform_fee_amount           Decimal? @db.Decimal(12, 2)
  service_fee_amount            Decimal? @db.Decimal(12, 2) // customer-paid card service fee; NULL on every non-card and pre-feature payment. Never part of Payment.amount or invoice totals.
  tip_amount                    Decimal? @db.Decimal(12, 2) // customer-paid pay-time tip (D10); NULL when none given. Rides on the payment, not Invoice.tip - never part of Payment.amount or invoice totals.
  net_amount                    Decimal? @db.Decimal(12, 2)
  stripe_balance_transaction_id String?
  stripe_account_id             String?  // which Stripe account the charge lives on; NULL = legacy platform-account
  reference_number         String?
  notes                    String?
  refunded_at              DateTime?
  refunded_amount          Decimal?           @db.Decimal(12, 2)
  created_at               DateTime           @default(now())
  // --- Entity-redesign §8: void-payment (involuntary; never deletes — audit) ---
  voided_at                DateTime?
  voided_reason            String?
  voided_by                String?            @db.Uuid
  void_category            VoidPaymentReason?
  collector                User?              @relation("PaymentCollectedBy", fields: [collected_by], references: [id])
  voided_by_user           User?              @relation("PaymentVoidedBy", fields: [voided_by], references: [id])
  invoice                  Invoice            @relation(fields: [invoice_id], references: [id], onDelete: Restrict)
  refunds                  Refund[]

  // --- Creator tracking (audit only). NOTHING reads these for authorization. ---
  // Immutable, written once at create. Same shape and rationale as Job - see that model.
  // NOT a duplicate of collected_by above: collected_by is who handled the money, this is who caused
  // the row to exist. They agree on a staff-recorded payment and diverge on the two rows nobody
  // collected - a Stripe webhook payment (CLIENT, the customer paid themselves) and a deposit-credit
  // ledger payment (SYSTEM, the platform minted it). That divergence is why created_by_source exists.
  // -> md_files/specs/permissions/2026-08-04-technician-ownership-and-creator-tracking.md (Part A)
  created_by_id     String?         @db.Uuid
  created_by_name   String?
  created_by_source CreatedBySource @default(UNKNOWN)
  creator           User?           @relation("PaymentCreator", fields: [created_by_id], references: [id], onDelete: SetNull)

  @@index([invoice_id])
  @@index([created_by_id])
  @@map("payments")
}

model Attachment {
  id           String            @id @default(uuid()) @db.Uuid
  entity_type  AttachmentEntity
  entity_id    String            @db.Uuid
  file_name    String
  file_url     String
  storage_path String? // canonical bucket path; signed URLs are minted from this
  file_type    String
  file_size    Int
  display_name String
  description  String            @default("")
  context      AttachmentContext @default(OTHER)
  uploaded_by  String            @db.Uuid
  created_at   DateTime          @default(now())
  uploader     User              @relation("AttachmentUploadedBy", fields: [uploaded_by], references: [id])

  // --- Creator tracking (audit only). NOTHING reads these for authorization. ---
  // Immutable, written once at create. Same shape and rationale as Job - see that model.
  // Attachment is the one model in this slice that already had an actor: uploaded_by is NOT NULL with
  // a hard FK. These columns are carried anyway so the audit shape is uniform across every creatable
  // entity, and so the answer survives a permanent user delete - uploaded_by cannot, being a required
  // relation.
  // -> md_files/specs/permissions/2026-08-04-technician-ownership-and-creator-tracking.md (Part A)
  created_by_id     String?         @db.Uuid
  created_by_name   String?
  created_by_source CreatedBySource @default(UNKNOWN)
  creator           User?           @relation("AttachmentCreator", fields: [created_by_id], references: [id], onDelete: SetNull)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([entity_type, entity_id])
  @@index([organization_id])
  @@index([created_by_id])
  @@map("attachments")
}

