// ─── Logistic Orders v1 (spec 2026-07-20) — the goods-issue document ─────────
// An LO is the ONLY office path that consumes stock under the v1 doctrine. It is
// not an adjustment (those carry date + reason + actor separately) and not a
// billing document — an LO issues goods, billing lives on job/invoice lines.

// RETURNED is terminal and distinct from CANCELLED (spec §14 H1): CANCELLED =
// never deducted; RETURNED = deducted then unwound by a document verb. Shipping
// it from day one avoids a later enum migration on a live status column.
enum LogisticOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROCESSED
  CANCELLED
  RETURNED
}

model LogisticOrder {
  id     String              @id @default(uuid()) @db.Uuid
  number String
  // Per-anchor sequence, persisted as an int because string sort puts `-10`
  // before `-2` (spec §11 build note b). NULL for standalone flat `LO00001`
  // numbers, NOT NULL for anchored ones — this is the AUTHORITATIVE flat/anchored
  // discriminator, and the flat counter's self-heal subquery keys off it
  // (`WHERE t.seq IS NULL`, see lib/numbering.ts). It deliberately does NOT use a
  // hyphen-in-the-number heuristic: PREFIX_REGEX permits a hyphen in
  // logistic_order_prefix, so a flat number can contain one too.
  //
  // Records how the NUMBER was SHAPED at creation, NOT what the row links to now —
  // independent axes, and NO constraint ties them. A flat LO re-linked to a job
  // later keeps seq NULL (numbers are immutable; re-linking never renumbers), and an
  // anchored LO whose anchor is deleted keeps its seq with every FK nulled. Both are
  // legal. See the "DELIBERATELY NO CHECK" note in
  // 20260720120000_logistic_orders_foundations before proposing one.
  seq    Int?
  status LogisticOrderStatus @default(DRAFT)

  // Anchors — all optional, all SetNull. "It's just a link": an LO whose anchor
  // is deleted survives unanchored as a historical document (spec §14 C1).
  // Numbering precedence, most specific first: job > invoice > estimate > lead >
  // customer > service_plan. Only the winner shapes the number; the rest stay
  // plain links, and the number is minted once and never re-derived.
  job_id          String? @db.Uuid
  invoice_id      String? @db.Uuid
  estimate_id     String? @db.Uuid
  lead_id         String? @db.Uuid
  customer_id     String? @db.Uuid
  service_plan_id String? @db.Uuid

  notes String? @db.Text

  // Actor trail. created_by is required (Estimate.created_by precedent — implicit
  // Restrict; permanentDelete already refuses users carrying history). The three
  // lifecycle actors are nullable + SetNull: they are stamped as the LO advances,
  // and the audit trail must survive a hard user delete.
  created_by       String    @db.Uuid
  submitted_at     DateTime?
  submitted_by     String?   @db.Uuid
  approved_at      DateTime?
  approved_by      String?   @db.Uuid
  processed_at     DateTime?
  processed_by     String?   @db.Uuid
  cancelled_at     DateTime?
  // Optional by design — the deliberate asymmetry against the REQUIRED manual
  // adjustment reason (spec §12 rec 7).
  cancelled_reason String?   @db.Text
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  job          Job?         @relation("LogisticOrderJob", fields: [job_id], references: [id], onDelete: SetNull)
  invoice      Invoice?     @relation("LogisticOrderInvoice", fields: [invoice_id], references: [id], onDelete: SetNull)
  estimate     Estimate?    @relation("LogisticOrderEstimate", fields: [estimate_id], references: [id], onDelete: SetNull)
  lead         Lead?        @relation("LogisticOrderLead", fields: [lead_id], references: [id], onDelete: SetNull)
  customer     Customer?    @relation("LogisticOrderCustomer", fields: [customer_id], references: [id], onDelete: SetNull)
  service_plan ServicePlan? @relation("LogisticOrderServicePlan", fields: [service_plan_id], references: [id], onDelete: SetNull)

  creator   User  @relation("LogisticOrderCreatedBy", fields: [created_by], references: [id])
  submitter User? @relation("LogisticOrderSubmittedBy", fields: [submitted_by], references: [id], onDelete: SetNull)
  approver  User? @relation("LogisticOrderApprovedBy", fields: [approved_by], references: [id], onDelete: SetNull)
  processor User? @relation("LogisticOrderProcessedBy", fields: [processed_by], references: [id], onDelete: SetNull)

  lines           LogisticOrderLine[]
  stock_movements StockMovement[]     @relation("StockMovementLogisticOrder")

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, number])
  @@index([organization_id])
  @@index([status])
  @@index([job_id])
  @@index([invoice_id])
  @@index([estimate_id])
  @@index([lead_id])
  @@index([customer_id])
  @@index([service_plan_id])
  @@map("logistic_orders")
}

model LogisticOrderLine {
  id                String   @id @default(uuid()) @db.Uuid
  logistic_order_id String   @db.Uuid
  // Ledger doctrine: the snapshots outlive a SetNull'd catalog item, so a dead
  // reference still renders in the editor and processing can name the sku in its
  // 422 instead of showing a blank row.
  item_id           String?  @db.Uuid
  item_sku          String
  item_name         String
  qty               Decimal  @db.Decimal(10, 2)
  // Nullable on DRAFT (the editor fills it from the default chain); processing
  // rejects any line still missing it. No uniqueness on (LO, item) — the same
  // item may be pulled from several locations across several lines (spec §3).
  from_location_id  String?  @db.Uuid
  sequence          Int
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  logistic_order  LogisticOrder      @relation(fields: [logistic_order_id], references: [id], onDelete: Cascade)
  item            PriceBookItem?     @relation("LogisticOrderLinePriceBookItem", fields: [item_id], references: [id], onDelete: SetNull)
  from_location   InventoryLocation? @relation("LogisticOrderLineFromLocation", fields: [from_location_id], references: [id], onDelete: SetNull)
  stock_movements StockMovement[]    @relation("StockMovementLogisticOrderLine")

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([logistic_order_id])
  @@index([item_id])
  @@index([organization_id])
  @@map("logistic_order_lines")
}

