  actor_user_id          String?  @db.Uuid
  // Logistic Orders (spec §3 / §14 H2): drill-through from the ledger back to the
  // LO that issued the goods. SetNull like every other ref here — the movement is
  // the permanent record; deleting an LO never rewrites history.
  logistic_order_id      String?  @db.Uuid
  logistic_order_line_id String?  @db.Uuid
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  from_location InventoryLocation? @relation("MovementFromLocation", fields: [from_location_id], references: [id])
  to_location   InventoryLocation? @relation("MovementToLocation", fields: [to_location_id], references: [id])

  item              PriceBookItem?   @relation("StockMovementPriceBookItem", fields: [item_id], references: [id], onDelete: SetNull)
  job               Job?             @relation("StockMovementJob", fields: [job_id], references: [id], onDelete: SetNull)
  job_line_item     JobLineItem?     @relation("StockMovementJobLine", fields: [job_line_item_id], references: [id], onDelete: SetNull)
  invoice_line_item InvoiceLineItem? @relation("StockMovementInvoiceLine", fields: [invoice_line_item_id], references: [id], onDelete: SetNull)
  actor_user        User?            @relation("StockMovementActor", fields: [actor_user_id], references: [id], onDelete: SetNull)

  logistic_order      LogisticOrder?     @relation("StockMovementLogisticOrder", fields: [logistic_order_id], references: [id], onDelete: SetNull)
  logistic_order_line LogisticOrderLine? @relation("StockMovementLogisticOrderLine", fields: [logistic_order_line_id], references: [id], onDelete: SetNull)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([from_location_id])
  @@index([to_location_id])
  @@index([item_id])
  @@index([job_id])
  @@index([job_line_item_id])
  @@index([invoice_line_item_id])
  @@index([actor_user_id])
  @@index([logistic_order_id])
  @@index([logistic_order_line_id])
  @@map("stock_movements")
}

