model ServicePlan {
  id                  String            @id @default(uuid()) @db.Uuid
  service_plan_number String
  customer_id         String            @db.Uuid
  service_location_id String            @db.Uuid
  name                String
  status              ServicePlanStatus @default(DRAFT)
  visit_cadence       VisitCadence
  // Structured (Google-Calendar-style) recurrence. Nullable for back-compat: a row with a null
  // interval_unit derives its rule from visit_cadence. When set, these fields drive the engine and
  // visit_cadence holds a best-fit legacy label. byweekday holds 0–6 (0=Sun) for WEEK only;
  // occurrence_count is the "after N visits" terminator (paired with the nullable end_date).
  // See backend/src/lib/servicePlans/derive.ts (toRule).
  interval_unit       IntervalUnit?
  interval_count      Int?
  byweekday           Int[]             @default([])
  occurrence_count    Int?
  start_date          DateTime
  end_date            DateTime?
  contract_price      Decimal           @db.Decimal(12, 2)
  sold_by             String?           @db.Uuid
  renewals_count      Int               @default(0)
  template_id         String?           @db.Uuid
  created_at          DateTime          @default(now())
