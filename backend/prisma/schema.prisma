model Job {
  id                      String              @id @default(uuid()) @db.Uuid
  job_number              String
  // Editable record IDs (Workiz dual-run) — see numbering.ts self-heal + rename transaction.
  number_is_custom        Boolean             @default(false)
  original_number         String?
  estimate_seq            Int                 @default(0) // SERV10X-61 - per-job estimate container counter (J00007-1)
  customer_id             String              @db.Uuid
  service_location_id     String              @db.Uuid
  estimate_id             String?             @unique @db.Uuid
  status                  JobStatus           @default(UNSCHEDULED)
  // SRVW-112 - the org-defined label UNDER the fixed parent status (Workiz parity). Always
  // parented: the setter rejects a sub-status whose parent differs from this job's status, and
  // every status-writing handler nulls it when the status actually moves (lib/job-sub-status.ts).
  sub_status_id           String?             @db.Uuid
  // --- Multi-visit S8 §2/§3 (D14, A5 RATIFIED): the FORWARD-looking schedule mirror is DROPPED.
  // scheduled_start / scheduled_end / is_all_day used to live here, maintained by
  // syncJobFromVisits as a write-through cache of the job's next upcoming live visit. They are
  // GONE as stored columns (S8's own DROP migration) - the three wire keys survive on READ ONLY,
  // computed fresh off `visits[]` by lib/job-schedule-projection.ts (backend/src), using the
  // identical "next upcoming live visit, fallback to earliest non-cancelled visit, zero visits ->
  // null" rule this column used to encode on write. New code should read `visits[]` directly;
  // #1696 tracks the eventual visits[]-native migration of the ~10 pre-existing flat-scalar
  // consumers (job detail hero, jobs list + CSV, dashboard widgets, invoices list, customer
  // detail, copilot tools) this projection exists to keep working unmodified in the meantime.
  //
  // en_route_at / on_site_at (the job-level milestone mirror) are ALSO DROPPED here, with NO
  // read-time replacement: S5 already repointed every reader of those two names onto the VISIT's
  // own columns, so by the time S8 runs they are write-only dead weight. jobs.started_at is NOT
  // symmetric and SURVIVES - deriveJobStatusFromVisits' urgent-workflow branch
  // (`if (jobStartedAt != null) return 'IN_PROGRESS'`) still reads it, and it is the ACTUAL-start
  // half of the duration span below.
  //
  // --- Multi-visit S8 §4 (D14(i), A2+): the BACKWARD-LOOKING duration span. -------------------
  // Three columns, stored and maintained by syncJobFromVisits (walkthrough.service.ts) in the
  // same transaction as every visit write, plus a one-time backfill in the S8 §4 migration.
  // Together they answer "how long did this job take", as TWO DIFFERENT pairs - do not read
  // first_visit_start/last_visit_end as actual stamps, and do not read last_visit_completed_at
  // as anything but the ACTUAL half:
  //     PLANNED span = first_visit_start        -> last_visit_end
  //     ACTUAL  span = jobs.started_at (existing, mirrorMilestone('started_at')) -> last_visit_completed_at
  // All three are computed over NON-CANCELLED visits only (D19: a cancelled trip is kept as
  // history and must not be read as evidence of planned or actual work) and are NULL when the
  // job has no qualifying visit. Unlike the now-DROPPED scheduled_start mirror (which nulled out
  // the moment the last live visit was worked), these never go back to null once a visit has
  // ever existed - they are a record of what happened, not of what is next.
  //
  // first_visit_start - MIN(visits.scheduled_at) over non-cancelled visits.        [PLANNED start]
  first_visit_start       DateTime?
  // last_visit_end - MAX(visits.scheduled_end) over non-cancelled visits. This is the PLANNED
  // end of the last trip's WINDOW - it is set the moment a visit is booked, whether or not that
  // visit, or any visit, has actually happened yet. It is NOT when work finished; do not confuse
  // it with last_visit_completed_at below, which is the only one of these three built from an
  // ACTUAL stamp.                                                                  [PLANNED end]
  last_visit_end          DateTime?
  // last_visit_completed_at - MAX(visits.completed_at) over non-cancelled visits. The ACTUAL
  // stamp of when the last trip was marked done - null until at least one non-cancelled visit on
  // this job has been completed, and paired with jobs.started_at (not with first_visit_start) to
  // read the job's real, worked duration.                                          [ACTUAL end]
  last_visit_completed_at DateTime?
  scope_notes             String?
  scopes                  Json?
  // --- Custom Fields (SRVW-114): { "<definition-uuid>": <scalar> } ---
  custom_fields           Json                @default("{}")
  job_type                String?
  completed_at            DateTime?
  cancelled_at            DateTime?
  cancelled_reason        String?
  started_at              DateTime?
  estimated_duration      Int?
  completion_notes        String?
  signature_data          String?
  signature_ip            String?
  signature_at            DateTime?
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt
  // --- Entity-redesign §5: cached amount-invoiced-vs-estimate tracking ---
  amount_invoiced         Decimal             @default(0) @db.Decimal(12, 2)
  // E1/E2 (2026-08-04) - the JOB owns its tax rate and discount; it no longer borrows them from an
  // attached estimate. Same shape Estimate carries, deliberately: Estimate / Job / Invoice must
  // render one identical money breakdown. tax_rate is stamped from the service location's state at
  // create. discount_amount is RESOLVED and stored, never re-derived from discount_value against a
  // changing item set - ServiceTitan documents that drift as their top billing-support driver.
  // -> md_files/plans/jobs/2026-08-04-job-owns-its-tax-and-discount-workiz-parity.md
  tax_rate                Decimal             @default(0) @db.Decimal(6, 5)
  discount_type           DiscountType?
  discount_value          Decimal?            @db.Decimal(12, 2)
  discount_amount         Decimal             @default(0) @db.Decimal(12, 2)
  // R3b (2026-07-21) — cost model (D2/D8/D18), same shape as Estimate's. Nullable — null means
  // "use org default" (Organization.labor_rate/overhead_mode/overhead_value). Copied from the
  // source Estimate on conversion (job.controller.ts create()); org-default fallback only when a
  // Job is created from scratch (no estimate_id).
  labor_hours             Decimal?            @db.Decimal(8, 2)
  overhead_mode           DepositDefaultType?
  overhead_value          Decimal?            @db.Decimal(12, 2)
  invoices                Invoice[]
  customer                Customer            @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  // "JobPrimaryEstimate" — see Estimate.job's comment. Named because R6 adds a second,
  // independent Job<->Estimate relation (Estimate.job_id / linked_estimates below).
  estimate                Estimate?           @relation("JobPrimaryEstimate", fields: [estimate_id], references: [id], onDelete: Restrict)
  service_location        ServiceLocation     @relation(fields: [service_location_id], references: [id])

  // --- Emanuel inventory/comms unified back-relations ---
  purchase_orders       PurchaseOrder[]
  rfqs                  Rfq[]
  estimate_reservations EstimateReservation[]
  job_stages            JobStage[]
  stock_approvals       StockApproval[]
  call_sessions         CallSession[]
  stock_movements       StockMovement[]       @relation("StockMovementJob")

  // --- Scheduler redesign: crew M2M spine (legacy assigned_to dropped in TG7) ---
  // --- Multi-visit S1: relation lands now; slice S2 hangs job visits off it ---
  visits                           Visit[]
  customer_scheduled_email_sent_at DateTime?
  // --- Demo widget: dispatcher attribution (dispatch scoreboard) ---
  dispatcher_id                    String?           @db.Uuid
  dispatcher                       User?             @relation("JobDispatcher", fields: [dispatcher_id], references: [id], onDelete: SetNull)
  // --- Automation Center: audience model. Nullable/writer-less for now (Ran will populate
  // when leadless jobs get a mandatory salesperson); until then the resolver falls back to
  // the linked lead's owner. ---
  salesperson_id                   String?           @db.Uuid
  salesperson                      User?             @relation("JobSalesperson", fields: [salesperson_id], references: [id], onDelete: SetNull)
  // --- Creator tracking. CREATION CONFERS CONTROL - created_by_id IS an authorization input. ---
  // A user who creates a job has full control over it - read, edit the money, reassign, delete -
  // permanently, even after a dispatcher hands the work to someone else. There is deliberately no
  // transfer story; the column is immutable and that is exactly why it can answer "did you make
  // this?". The rule is system-wide, not a technician rule, and it only ever ADDS access - higher
  // roles reach the same rows through their own org-wide grants. TECHNICIAN's creator-scoped
  // manage_lines/assign/unassign/delete Job grants read this column
  // (lib/permissions/defaultGrants.ts CREATED_BY_ME); created_by_name and created_by_source do NOT
  // - they are the audit half.
  //
  // Immutable, written once at create. SetNull (not Restrict): DELETE /api/users/:id/permanent must
  // not be blocked by every job a departing employee ever made - created_by_name is the snapshot
  // that keeps the audit answer readable once the user row is gone. A permanent delete therefore
  // also drops the creator's control grant to nobody, which is the right direction: admins still
  // reach the row, and no live user inherits a departed employee's authority. created_by_source
  // distinguishes "the customer did this" from "we do not know"; UNKNOWN is the honest default for
  // the rows that predate the column.
  // -> md_files/specs/permissions/2026-08-04-technician-ownership-and-creator-tracking.md (Part A)
  created_by_id                    String?           @db.Uuid
  created_by_name                  String?
  created_by_source                CreatedBySource   @default(UNKNOWN)
  creator                          User?             @relation("JobCreator", fields: [created_by_id], references: [id], onDelete: SetNull)
  // --- Service Plans ---
  source_plan_id                   String?           @db.Uuid
  // Restrict (not SetNull): a plan with materialized visit-jobs must not be deletable out from
  // under them — SetNull would orphan the jobs AND silently un-suppress their billing (the
  // non-billable guard keys off source_plan_id). Plan delete is draft-only and drafts have no
  // visit-jobs, so this never blocks a legitimate delete; it's a fail-closed backstop.
  source_plan                      ServicePlan?      @relation(fields: [source_plan_id], references: [id], onDelete: Restrict)
  plan_visits                      PlanVisit[]
  // --- Communication ↔ Jobs: per-message job attribution back-relations ---
  messages                         Message[]         @relation("JobMessages")
  emails                           Email[]           @relation("JobEmails")
  whatsapp_messages                WhatsAppMessage[] @relation("JobWhatsAppMessages")
  // --- SERV10X-38: job-owned items ---
  job_line_items                   JobLineItem[]
  // --- Logistic Orders ---
  logistic_orders                  LogisticOrder[]   @relation("LogisticOrderJob")
  // R6 (2026-07-22) — M4 back-relation: estimates whose Estimate.job_id points at this job.
  linked_estimates                 Estimate[]        @relation("EstimateJobLink")
  // SRVW-112 - SetNull, not Restrict: deleting a sub-status from the settings editor must not be
  // blocked by historical jobs that still hold it. The label simply disappears off those jobs.
  sub_status                       JobSubStatus?     @relation(fields: [sub_status_id], references: [id], onDelete: SetNull)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, job_number])
  @@index([customer_id])
  @@index([status])
  @@index([sub_status_id])
  // A1: JOB_SORT_FIELDS.scheduled now orders by this column (sortFields.ts) - the Jobs list's
  // Scheduled sort runs through it on every request. The old `@@index([scheduled_start])` is
  // DROPPED with the column itself (S8, RATIFIED) - dropping a column drops its index too, but
  // the migration names the DROP INDEX explicitly anyway, matching this file's own house style
  // (see the S8 §4 migration's comment on why a named drop keeps the ledger honest).
  @@index([first_visit_start])
  @@index([estimate_id])
  @@index([source_plan_id])
  @@index([dispatcher_id])
  @@index([salesperson_id])
  @@index([organization_id])
  @@map("jobs")
}

/**
 * SRVW-112 - per-org sub-status catalog, one level under the FIXED JobStatus enum.
 * `parent` reuses the JobStatus enum as a USAGE, not a new declaration - enum JobStatus is
 * deliberately not widened (that would change the copilot's advertised status vocabulary, every
 * report bucket and the registry schema guard). Workiz's "Pending" / "Done pending approval" are
 * expressed here as org-defined labels under an existing parent instead.
 */
model JobSubStatus {
  id         String    @id @default(uuid()) @db.Uuid
  parent     JobStatus
  label      String
  sort_order Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  jobs       Job[]

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, parent, label])
  @@index([organization_id, parent, sort_order])
  @@map("job_sub_statuses")
}

/**
 * SRVW-111 (label-override shape) - per-org display overrides for the FIXED LeadStatus enum:
 * rename, reorder, hide, and which status a new lead defaults to. `status` reuses the LeadStatus
 * enum as a USAGE, not a new declaration, for the same reason JobSubStatus.parent does - widening
 * LeadStatus would change Servy's advertised lead vocabulary and the registry schema guard.
 * At most one row per (org, status); at most one row per org may have is_default true (enforced
 * in the controller transaction, not a DB constraint - mirrors User.is_default's own pattern).
 */
model LeadStatusOverride {
  id         String     @id @default(uuid()) @db.Uuid
  status     LeadStatus
  label      String?
  sort_order Int        @default(0)
  is_default Boolean    @default(false)
  hidden     Boolean    @default(false)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, status])
  @@map("lead_status_overrides")
}

model Invoice {
  id                     String        @id @default(uuid()) @db.Uuid
  invoice_number         String
  // Editable record IDs (Workiz dual-run) — see numbering.ts self-heal + rename transaction.
  number_is_custom       Boolean       @default(false)
  original_number        String?
  job_id                 String?       @db.Uuid
  status                 InvoiceStatus @default(DRAFT)
  subtotal               Decimal       @db.Decimal(12, 2)
  tax_amount             Decimal       @db.Decimal(12, 2)
  deposit_credit         Decimal       @default(0) @db.Decimal(12, 2)
  total_amount           Decimal       @db.Decimal(12, 2)
  amount_due             Decimal       @db.Decimal(12, 2)
  discount_amount        Decimal       @default(0) @db.Decimal(12, 2)
  // R5c (2026-07-22) -- widened 5,4 -> 6,5, same reason as Estimate.tax_rate above.
  tax_rate               Decimal       @default(0) @db.Decimal(6, 5)
  voided_at              DateTime?
  voided_reason          String?
  public_token           String?       @unique
  sent_at                DateTime?
  paid_at                DateTime?
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt
  due_date               DateTime?     @db.Timestamptz(6)
  total_refunded         Decimal       @default(0) @db.Decimal(12, 2)
  refunded_at            DateTime?
  refund_reason          String?
  refund_reason_category String?
  refunded_by            String?       @db.Uuid

  // --- Entity-redesign §6/§8. job_id nullable (deposit/orphan invoices have no job); customer_id REQUIRED. ---
  kind              InvoiceKind         @default(STANDARD)
  estimate_id       String?             @db.Uuid
  customer_id       String              @db.Uuid
  stripe_dispute_id String?
  net_collected     Decimal             @default(0) @db.Decimal(12, 2)
  tip               Decimal             @default(0) @db.Decimal(12, 2)
  scopes            Json?
  // R3b (2026-07-21) — cost model (D2/D8/D18), same shape as Estimate's. Nullable — null means
  // "use org default". Copied from the source Job on conversion via the PRIMARY create() path
  // (invoice.controller.ts) only — job.controller.ts's createInvoiceFromJob() (partial/progress
  // draw invoices) deliberately leaves these null; see that function's own comment for why.
  labor_hours       Decimal?            @db.Decimal(8, 2)
  overhead_mode     DepositDefaultType?
  overhead_value    Decimal?            @db.Decimal(12, 2)

  // --- Service Plans ---
  service_plan_id String?      @db.Uuid
  service_plan    ServicePlan? @relation(fields: [service_plan_id], references: [id], onDelete: SetNull)

  refunded_by_user             User?                      @relation("InvoiceRefundedBy", fields: [refunded_by], references: [id])
  job                          Job?                       @relation(fields: [job_id], references: [id], onDelete: Restrict)
  estimate                     Estimate?                  @relation(fields: [estimate_id], references: [id], onDelete: Restrict)
  customer                     Customer                   @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  payments                     Payment[]
  line_items                   InvoiceLineItem[]
  refunds                      Refund[]
  credits                      Credit[]
  applied_credits              DepositCreditApplication[] @relation("DepositInvoiceApplications")
  received_credit_applications DepositCreditApplication[] @relation("TargetInvoiceApplications")
  logistic_orders              LogisticOrder[]            @relation("LogisticOrderInvoice")

  // --- Creator tracking (audit only). NOTHING reads these for authorization. ---
  // Immutable, written once at create. Same shape and rationale as Job - see that model. An invoice
  // a user chose to raise is USER; the ones a service plan's own billing schedule materialises are
  // SYSTEM, matching how PR 1 treated a plan visit job.
  // -> md_files/specs/permissions/2026-08-04-technician-ownership-and-creator-tracking.md (Part A)
  created_by_id     String?         @db.Uuid
  created_by_name   String?
  created_by_source CreatedBySource @default(UNKNOWN)
  creator           User?           @relation("InvoiceCreator", fields: [created_by_id], references: [id], onDelete: SetNull)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, invoice_number])
  @@index([created_by_id])
  @@index([status])
  @@index([organization_id])
  @@index([customer_id])
  @@index([estimate_id])
  @@index([kind])
  @@index([stripe_dispute_id])
  @@index([service_plan_id])
  @@map("invoices")
}

// Entity-redesign §6: the Invoice owns its line items (estimate snapshot or change-order lines).
model InvoiceLineItem {
  id                 String            @id @default(uuid()) @db.Uuid
  invoice_id         String            @db.Uuid
  sequence           Int
  description        String
  quantity           Decimal           @db.Decimal(10, 2)
  unit_price         Decimal           @db.Decimal(12, 2)
  is_taxable         Boolean           @default(true)
  line_total         Decimal           @db.Decimal(12, 2)
  price_book_item_id String?           @db.Uuid
  unit_cost          Decimal?          @db.Decimal(12, 2)
  discount_type      DiscountType?
  discount_value     Decimal?          @db.Decimal(12, 2)
  discount_amount    Decimal           @default(0) @db.Decimal(12, 2)
  item_type          PriceBookItemType @default(SERVICE)
  stock_status       StockSyncStatus   @default(NOT_TRACKED)
  stock_location_id  String?           @db.Uuid
  invoice            Invoice           @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  price_book_item    PriceBookItem?    @relation(fields: [price_book_item_id], references: [id])

  // --- SERV10X-38: job-owned items — optional pointer back to the JobLineItem this invoice
  // line was generated from, plus the markup applied at invoice time. ---
  job_line_item_id String?      @db.Uuid
  markup_percent   Decimal?     @db.Decimal(5, 2)
  source_job_line  JobLineItem? @relation(fields: [job_line_item_id], references: [id], onDelete: SetNull)

  stock_location  InventoryLocation? @relation("InvoiceLineStockLocation", fields: [stock_location_id], references: [id], onDelete: SetNull)
  stock_movements StockMovement[]    @relation("StockMovementInvoiceLine")

  @@index([invoice_id])
  @@index([price_book_item_id])
  @@index([stock_location_id])
  @@index([job_line_item_id])
  @@map("invoice_line_items")
}

// SERV10X-38: the Job's own item store (independent of any Invoice) — items live on the job
// from the moment they're added, and can later be copied onto an Invoice's line items.
model JobLineItem {
  id                 String             @id @default(uuid()) @db.Uuid
  job_id             String             @db.Uuid
  sequence           Int
  description        String
  quantity           Decimal            @db.Decimal(10, 2)
  unit_price         Decimal            @db.Decimal(12, 2)
  unit_cost          Decimal?           @db.Decimal(12, 2)
  markup_percent     Decimal?           @db.Decimal(5, 2)
  is_taxable         Boolean            @default(true)
  line_total         Decimal            @db.Decimal(12, 2)
  discount_type      DiscountType?
  discount_value     Decimal?           @db.Decimal(12, 2)
  discount_amount    Decimal            @default(0) @db.Decimal(12, 2)
  item_type          PriceBookItemType  @default(SERVICE)
  price_book_item_id String?            @db.Uuid
  stock_status       StockSyncStatus    @default(NOT_TRACKED)
  stock_location_id  String?            @db.Uuid
  organization_id    String             @db.Uuid
  job                Job                @relation(fields: [job_id], references: [id], onDelete: Cascade)
  price_book_item    PriceBookItem?     @relation(fields: [price_book_item_id], references: [id])
  invoice_lines      InvoiceLineItem[]
  stock_location     InventoryLocation? @relation("JobLineStockLocation", fields: [stock_location_id], references: [id], onDelete: SetNull)
  stock_movements    StockMovement[]    @relation("StockMovementJobLine")

  @@index([job_id])
  @@index([organization_id])
  @@index([price_book_item_id])
  @@index([stock_location_id])
  @@map("job_line_items")
}

model ServicePlan {
  id                  String            @id @default(uuid()) @db.Uuid
  service_plan_number String
  customer_id         String            @db.Uuid
  service_location_id String            @db.Uuid
  name                String
  status              ServicePlanStatus @default(DRAFT)
  visit_cadence       VisitCadence
  // Structured (Google-Calendar-style) recurrence. Nullable for back-compat: a row with a null
  // interval_unit derives its rule from visit_cadence. When set, these fields drive the engine and
  // visit_cadence holds a best-fit legacy label. byweekday holds 0–6 (0=Sun) for WEEK only;
  // occurrence_count is the "after N visits" terminator (paired with the nullable end_date).
  // See backend/src/lib/servicePlans/derive.ts (toRule).
  interval_unit       IntervalUnit?
  interval_count      Int?
  byweekday           Int[]             @default([])
  occurrence_count    Int?
  start_date          DateTime
  end_date            DateTime?
  contract_price      Decimal           @db.Decimal(12, 2)
  sold_by             String?           @db.Uuid
  renewals_count      Int               @default(0)
  template_id         String?           @db.Uuid
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  customer         Customer                  @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  service_location ServiceLocation           @relation(fields: [service_location_id], references: [id], onDelete: Restrict)
  sold_by_user     User?                     @relation("ServicePlanSoldBy", fields: [sold_by], references: [id], onDelete: SetNull)
  template         ServicePlanTemplate?      @relation(fields: [template_id], references: [id], onDelete: SetNull)
  line_items       ServicePlanLineItem[]
  material_lines   ServicePlanMaterialLine[]
  visits           PlanVisit[]
  invoices         Invoice[]
  jobs             Job[]
  logistic_orders  LogisticOrder[]           @relation("LogisticOrderServicePlan")

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, service_plan_number])
  @@index([customer_id])
  @@index([service_location_id])
  @@index([status])
  @@index([organization_id])
  @@map("service_plans")
}

model ServicePlanLineItem {
  id              String       @id @default(uuid()) @db.Uuid
  service_plan_id String       @db.Uuid
  name            String
  quantity        Int
  unit_price      Decimal      @db.Decimal(12, 2)
  position        Int
  organization_id String       @db.Uuid
  service_plan    ServicePlan  @relation(fields: [service_plan_id], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([service_plan_id])
  @@index([organization_id])
  @@map("service_plan_line_items")
}

// Logistic Orders §15: the plan's default materials template. Deliberately plan
// DATA, not a TEMPLATE-status LogisticOrder — a template has no number, no
// lifecycle and no anchors, and polluting the LO status enum would leak into
// every list, count and report. scheduleVisit instantiates these into one DRAFT
// LO per visit-job (instantiatePlanMaterials); template edits never retro-change
// an already-minted LO.
model ServicePlanMaterialLine {
  id              String   @id @default(uuid()) @db.Uuid
  service_plan_id String   @db.Uuid
  // Snapshots mirror LogisticOrderLine: a SetNull'd item still renders in the
  // builder with a "removed from catalog" hint, and the mint step can skip the
  // dead line while naming it in the LO's notes (§15 decision 7).
  item_id         String?  @db.Uuid
  item_sku        String
  item_name       String
  qty             Decimal  @db.Decimal(10, 2)
  position        Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  service_plan ServicePlan    @relation(fields: [service_plan_id], references: [id], onDelete: Cascade)
  item         PriceBookItem? @relation("ServicePlanMaterialLinePriceBookItem", fields: [item_id], references: [id], onDelete: SetNull)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([service_plan_id])
  @@index([organization_id])
  @@map("service_plan_material_lines")
}

model PlanVisit {
  id              String          @id @default(uuid()) @db.Uuid
  organization_id String          @db.Uuid
  service_plan_id String          @db.Uuid
  job_id          String?         @db.Uuid
  visit_number    Int
  scheduled_date  DateTime
  status          PlanVisitStatus @default(SCHEDULED)
  completed_at    DateTime?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  service_plan ServicePlan  @relation(fields: [service_plan_id], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [job_id], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organization_id], references: [id])

  @@index([service_plan_id])
  @@index([job_id])
  @@index([organization_id])
  @@map("plan_visits")
}

model ServicePlanTemplate {
  id                    String       @id @default(uuid()) @db.Uuid
  organization_id       String       @db.Uuid
  name                  String
  description           String?
  job_type              String?
  default_visit_cadence VisitCadence
  term_months           Int
  default_visit_count   Int?
  default_price         Decimal      @db.Decimal(12, 2)
  accent_color          String?
  auto_renew            Boolean      @default(false)
  archived              Boolean      @default(false)
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt

  line_items   ServicePlanTemplateLineItem[]
  plans        ServicePlan[]
  organization Organization                  @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([archived])
  @@map("service_plan_templates")
}

model ServicePlanTemplateLineItem {
  id              String              @id @default(uuid()) @db.Uuid
  template_id     String              @db.Uuid
  name            String
  quantity        Int
  unit_price      Decimal             @db.Decimal(12, 2)
  position        Int
  organization_id String              @db.Uuid
  template        ServicePlanTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  organization    Organization        @relation(fields: [organization_id], references: [id])

  @@index([template_id])
  @@index([organization_id])
  @@map("service_plan_template_line_items")
}

// Entity-redesign §8: first-class Refund ledger row (partial + multiple; replaces scalar refund stamps).
model Refund {
  id                     String         @id @default(uuid()) @db.Uuid
  invoice_id             String         @db.Uuid
  payment_id             String?        @db.Uuid
  amount                 Decimal        @db.Decimal(12, 2)
  tax_portion            Decimal        @default(0) @db.Decimal(12, 2)
  non_taxable_concession Boolean        @default(false)
  method                 PaymentMethod
  reason                 String?
  reason_category        RefundCategory
  stripe_refund_id       String?        @unique
  refunded_by            String         @db.Uuid
  created_at             DateTime       @default(now())

  invoice          Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Restrict)
  payment          Payment? @relation(fields: [payment_id], references: [id], onDelete: Restrict)
  refunded_by_user User     @relation("RefundRefundedBy", fields: [refunded_by], references: [id])

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([invoice_id])
  @@index([payment_id])
  @@index([organization_id])
  @@map("refunds")
}

// Entity-redesign §8: Credit lowers the bill (no money moves); method-agnostic, audited.
model Credit {
  id          String   @id @default(uuid()) @db.Uuid
  invoice_id  String   @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  tax_portion Decimal  @default(0) @db.Decimal(12, 2)
  reason      String?
  category    String?
  created_by  String   @db.Uuid
  created_at  DateTime @default(now())

  invoice         Invoice @relation(fields: [invoice_id], references: [id], onDelete: Restrict)
  created_by_user User    @relation("CreditCreatedBy", fields: [created_by], references: [id])

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([invoice_id])
  @@index([organization_id])
  @@map("credits")
}

// Entity-redesign §6/§8: internal reversible drawdown ledger — guards against one deposit
// being credited to two invoices. Void/refund un-apply by setting reversed_at.
model DepositCreditApplication {
  id                 String    @id @default(uuid()) @db.Uuid
  deposit_invoice_id String    @db.Uuid
  target_invoice_id  String    @db.Uuid
  amount             Decimal   @db.Decimal(12, 2)
  reversed_at        DateTime?
  created_at         DateTime  @default(now())

  deposit_invoice Invoice @relation("DepositInvoiceApplications", fields: [deposit_invoice_id], references: [id])
  target_invoice  Invoice @relation("TargetInvoiceApplications", fields: [target_invoice_id], references: [id])

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([deposit_invoice_id])
  @@index([target_invoice_id])
  @@index([organization_id])
  @@map("deposit_credit_applications")
}

model Payment {
  id                            String             @id @default(uuid()) @db.Uuid
  invoice_id                    String             @db.Uuid
  amount                        Decimal            @db.Decimal(12, 2)
  method                        PaymentMethod
  paid_at                       DateTime
  collected_by                  String?            @db.Uuid
  stripe_payment_intent_id      String?
  stripe_fee_amount             Decimal?           @db.Decimal(12, 2)
  platform_fee_amount           Decimal?           @db.Decimal(12, 2)
  service_fee_amount            Decimal?           @db.Decimal(12, 2) // customer-paid card service fee; NULL on every non-card and pre-feature payment. Never part of Payment.amount or invoice totals.
  tip_amount                    Decimal?           @db.Decimal(12, 2) // customer-paid pay-time tip (D10); NULL when none given. Rides on the payment, not Invoice.tip - never part of Payment.amount or invoice totals.
  net_amount                    Decimal?           @db.Decimal(12, 2)
  stripe_balance_transaction_id String?
  stripe_account_id             String? // which Stripe account the charge lives on; NULL = legacy platform-account
  reference_number              String?
  notes                         String?
  refunded_at                   DateTime?
  refunded_amount               Decimal?           @db.Decimal(12, 2)
  created_at                    DateTime           @default(now())
  // --- Entity-redesign §8: void-payment (involuntary; never deletes — audit) ---
  voided_at                     DateTime?
  voided_reason                 String?
  voided_by                     String?            @db.Uuid
  void_category                 VoidPaymentReason?
  collector                     User?              @relation("PaymentCollectedBy", fields: [collected_by], references: [id])
  voided_by_user                User?              @relation("PaymentVoidedBy", fields: [voided_by], references: [id])
  invoice                       Invoice            @relation(fields: [invoice_id], references: [id], onDelete: Restrict)
  refunds                       Refund[]

  // --- Creator tracking (audit only). NOTHING reads these for authorization. ---
  // Immutable, written once at create. Same shape and rationale as Job - see that model.
  // NOT a duplicate of collected_by above: collected_by is who handled the money, this is who caused
  // the row to exist. They agree on a staff-recorded payment and diverge on the two rows nobody
  // collected - a Stripe webhook payment (CLIENT, the customer paid themselves) and a deposit-credit
  // ledger payment (SYSTEM, the platform minted it). That divergence is why created_by_source exists.
  // -> md_files/specs/permissions/2026-08-04-technician-ownership-and-creator-tracking.md (Part A)
  created_by_id     String?         @db.Uuid
  created_by_name   String?
  created_by_source CreatedBySource @default(UNKNOWN)
  creator           User?           @relation("PaymentCreator", fields: [created_by_id], references: [id], onDelete: SetNull)

  @@index([invoice_id])
  @@index([created_by_id])
  @@map("payments")
}

