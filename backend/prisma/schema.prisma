/// Fixed UUID for the first demo organization (single-tenant MVP seed).
/// Referenced directly by the DB DEFAULT on organization_id columns
/// so unscoped inserts (tests, seeders, existing controllers) route here
/// transparently.
///   DEMO_ORG_ID = '00000000-0000-0000-0000-000000000001'

model Organization {
  id                       String    @id @db.Uuid
  name                     String    @db.VarChar(200)
  legal_name               String?   @db.VarChar(200)
  address_line1            String    @db.VarChar(200)
  address_line2            String?   @db.VarChar(200)
  city                     String    @db.VarChar(100)
  state                    String    @db.VarChar(50)
  postal_code              String    @db.VarChar(20)
  country                  String    @default("US") @db.VarChar(2)
  timezone                 String?   @default("America/New_York") @db.VarChar(64) // IANA tz for server-side date rendering (emails/PDFs). Nullable: ServWave shares the staging DB and created this column nullable; code falls back to DEFAULT_TIMEZONE. See lib/timezone.ts. VarChar(64) matches the live staging column (org_settings migration created it 64; the idempotent B&G migration's VARCHAR(50) ADD COLUMN IF NOT EXISTS no-op'd).
  email                    String    @db.VarChar(200)
  phone                    String?   @db.VarChar(50)
  website                  String?   @db.VarChar(200)
  logo_url                 String?   @db.Text
  brand_color              String    @default("#242424") @db.VarChar(7)
  estimate_template        String    @default("alpha-classic") @db.VarChar(50)
  estimate_terms           String    @db.Text
  estimate_notes           String    @db.Text
  estimate_payment_terms   String    @db.Text
  invoice_terms            String    @default("") @db.Text
  invoice_notes            String    @default("") @db.Text
  invoice_payment_terms    String    @default("") @db.Text
  stripe_account_id        String? // null = no Stripe capability; set after Connect onboarding (9C2). Doubles as the gate: orgs without this cannot have CARD in accepted_payment_methods.
  stripe_charges_enabled   Boolean   @default(false) // real CARD gate (replaces "is stripe_account_id set")
  stripe_payouts_enabled   Boolean   @default(false) // drives the connect-your-bank nudge
  stripe_details_submitted Boolean   @default(false) // finished the first onboarding pass
  stripe_requirements_due  Json      @default("[]") // requirements.currently_due → "action needed"
  stripe_disabled_reason   String? // requirements.disabled_reason (restricted/rejected/paused)
  platform_fee_bps         Int       @default(50) // per-org platform fee, bps (50 = 0.5%); support-only knob. Card payments no longer use it - it survives as the disclosed_fee_bps written onto a TermsAcceptance.
  // NOTE: there is deliberately NO card-service-fee column. Paying by card always carries the
  // card service fee, so it has no per-org switch; the RATE is the CARD_SERVICE_FEE_BPS constant.
  ctm_account_id           String?   @unique // CTM sub-account id ("596375"); null = phone module not connected. UNIQUE = claim-jack guard across orgs.
  ctm_sms_ready            Boolean   @default(false) // A2P campaign approved on the CTM side — gates outbound SMS.
  accepted_payment_methods Json      @default("[]") // §4.5: array of PaymentMethod strings (CARD, EXTERNAL_CARD, BANK_TRANSFER, CHECK, CASH). Pre-fills Send Estimate modal + filters public estimate/invoice pages.
  source_options           Json      @default("[\"Google\",\"Referral\",\"Facebook\",\"Instagram\",\"Yelp\",\"Direct Mail\",\"Door Hanger\",\"Other\"]")
  job_type_options         Json      @default("[\"HVAC Service\",\"HVAC Install\",\"Plumbing\",\"Electrical\",\"General Maintenance\",\"Other\"]")
  billing_terms_options    Json      @default("[\"Net 15\",\"Net 30\",\"Net 60\",\"Due on Receipt\"]")
  // Demo org flag: when true the org keeps the mock-first surfaces (e.g. the
  // not-yet-backed Reports) so sales can show the full vision to prospects. Real
  // orgs (false) only ever see DB-backed reports — never fabricated data.
  // Surfaced on the /api/auth/me + login payloads as user.org_is_demo.
  is_demo                  Boolean   @default(false)
  plan                     Plan      @default(STARTER)
  trial_ends_at            DateTime?
  feature_overrides        Json      @default("{}")
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  // Per-org numbering configuration (industry standard — Xero/Zoho/QBO)
  lead_prefix              String    @default("L") @db.VarChar(10)
  estimate_prefix          String    @default("E") @db.VarChar(10)
  job_prefix               String    @default("J") @db.VarChar(10)
  invoice_prefix           String    @default("I") @db.VarChar(10)
  number_padding           Int       @default(5)
  lead_next_number         Int       @default(1)
  estimate_next_number     Int       @default(1)
  job_next_number          Int       @default(1)
  invoice_next_number      Int       @default(1)
