// Delivery lifecycle of an outbound email, as OURS - not as Resend's event names.
// We map provider events onto this closed set deliberately, so a provider adding
// an event type cannot silently widen the vocabulary the UI has to render.
//
//   QUEUED -> SENT -> [DEFERRED] -> DELIVERED | BOUNCED | FAILED
//
// DEFERRED is a retry loop, not a resting place: the provider is still trying, so
// a row can enter and leave it repeatedly before resolving. COMPLAINED is the one
// POST-delivery terminal - the recipient marked a message that already arrived as
// spam - so it follows DELIVERED rather than replacing it in the chain above.
//
// Mirrors the sibling SMS channel's queued/sent/delivered/failed vocabulary
// (messages.status), which is a bare String there; this one is a real enum.
enum EmailDeliveryStatus {
  QUEUED
  SENT
  DEFERRED
  DELIVERED
  BOUNCED
  FAILED
  COMPLAINED
}

// Whether a bounce is worth retrying. DERIVED from Resend's bounce.type
// (Permanent -> HARD, Temporary -> SOFT); Resend has no hard/soft field of its
// own. HARD means the address is dead and must stop being mailed; SOFT means a
// transient condition (full mailbox, greylisting) that may clear.
enum EmailBounceKind {
  HARD
  SOFT
}

// Email slice 6 (inbound reply capture): how a RECEIVED message was resolved
// against our own records. Null on every outbound row - this describes inbound
// only, and is deliberately an explicit stored column rather than something
// re-derived at query time, because two of the three states are NOT derivable
// from the anchors alone:
//
//  - MATCHED is derivable ("has a thread"), but the other two are not.
//  - UNMATCHED_SENDER means the reply token DID resolve a thread and we
//    deliberately refused to attach it, because the From address was not the
//    one we sent to. The thread is known; the decision not to trust it is the
//    fact worth storing. Without this column that is indistinguishable from
//    UNMATCHED_NO_TOKEN, and the operator loses the one-click link that
//    reply_token below still makes possible.
//  - UNMATCHED_NO_TOKEN means neither the token nor the RFC-5322 threading
//    headers resolved anything - free-composed mail replied to, or a token
//    stripped in transit.
//
// Never auto-create a customer or lead from unauthenticated inbound mail; both
// UNMATCHED_* states route to the manual queue instead of guessing (the plan's
// explicit rule, and the behaviour Pipedrive/Salesforce follow - HubSpot
// guesses at recent open deals and its users complain about wrong attribution).
enum InboundMatchState {
  MATCHED
  UNMATCHED_NO_TOKEN
  UNMATCHED_SENDER
}

// What the receiving MTA's DMARC evaluation said about the inbound `From`
// header, parsed out of the `Authentication-Results` header.
//
// CONFIRMED PRESENT 2026-08-05 by a real inbound message: Resend's inbound runs
// on Amazon SES (`inbound-smtp.us-east-1.amazonaws.com`) and stamps
// `Authentication-Results: amazonses.com; spf=...; dkim=...; dmarc=...`. The
// plan had branched on whether this header would exist at all; it does.
//
// WHY THIS IS SEPARATE FROM InboundMatchState. The two answer different
// questions and must not be collapsed. InboundMatchState says whether we
// attached the message to a thread; this says how much the `From` address was
// worth. "Address matched, DMARC passed" and "address matched, DMARC
// unavailable" are both MATCHED, and rendering them identically would be the
// same delivery dishonesty this whole plan exists to remove - one is
// cryptographically established, the other is an unverified string compare.
//
// DMARC IS THE RIGHT SIGNAL, not raw dkim=/spf=. DMARC passes only when an
// authenticated identifier ALIGNS with the `From` header domain, which is the
// exact property needed here. A bare `dkim=pass` can be a valid signature from
// some other domain entirely, which proves nothing about the claimed sender.
enum InboundAuthVerdict {
  // dmarc=pass - the From domain is cryptographically authenticated. A forged
  // From cannot produce this for a domain that publishes DMARC.
  PASS
  // dmarc=fail - an active forgery signal. Routes to UNMATCHED_SENDER even when
  // the address string matches expected_from.
  FAIL
  // dmarc=none - the SENDER's domain publishes no enforceable DMARC record, so
  // no assurance is purchasable at any price. Falls back to a string compare,
  // and must never be displayed as "verified".
  NO_POLICY
  // No Authentication-Results header, no dmarc= token within it, or a
  // temperror/permerror. All collapse here deliberately: a transient DNS
  // failure during evaluation leaves us knowing exactly as much as a missing
  // header does, and inventing a stronger state for it would be a lie.
  UNAVAILABLE
}

model Email {
  id                     String               @id @default(uuid()) @db.Uuid
  account                String
  from                   Json
  to                     String
  subject                String
  snippet                String               @db.Text
  body                   Json
  at                     String
  // epoch-ms; BigInt because epoch-ms overflows INT4 (serializers must Number() it)
  ts                     BigInt
  unread                 Boolean              @default(true)
  starred                Boolean              @default(false)
  folder                 String
  labels                 Json?
  has_attachment         Boolean?             @default(false)
  attachments            Json?
  // Email slice 8b: a real FK to EmailThread, not the bare Gmail-era string it
  // used to be (there was no Gmail thread behind it any more, and nothing
  // wrote it - see EmailThread's own comment). NULLABLE ON PURPOSE, not
  // NOT NULL, even though the backfill below gives every row one: the OTHER
  // Email writer, `persistTransactionalEmail` (lib/comm-persist.ts - every
  // system-generated transactional mirror: estimate/invoice/PO notices etc.),
  // is untouched by this slice and creates rows with no thread at all. Forcing
  // NOT NULL would require that deep, widely-called, "never throws" module to
  // also mint/attach a thread - a much bigger blast radius than 8b asked for.
  // Only the compose/reply send path (sendEmail) and the one-time backfill
  // migration populate this column today.
  thread_id              String?              @db.Uuid
  important              Boolean?             @default(false)
  snoozed_until          String?
  customer_id            String?              @db.Uuid
  lead_id                String?              @db.Uuid
  vendor_id              String?              @db.Uuid
  // Communication ↔ Jobs: per-message attribution (transactional sends stamp at origin)
  job_id                 String?              @db.Uuid
  job_label              String?
  // Message metadata - null on prototype/system rows. body_html currently has
  // NO writer at all: the Gmail ingest that used to populate it (and sanitize it
  // first) was deleted in email slice 0. The rule it enforced still stands and
  // is now unenforced by any code - whoever restores an inbound path must run
  // lib/email-html.ts's sanitizeEmailHtml before storing, because the inbox
  // renders this column through dangerouslySetInnerHTML with no client-side pass.
  direction              String? // in | out (canonical comm vocab - never inbound/outbound)
  // Resend's own id for the accepted message - the correlation key a delivery
  // webhook arrives with, and the ONLY thing tying an event back to this row.
  // Unique so a replayed webhook updates instead of duplicating; the unique
  // index is also the lookup the webhook handler reads by, so no separate
  // @@index is added for it.
  provider_message_id    String?              @unique
  // Delivery lifecycle. NULLABLE rather than defaulted: null means "nothing has
  // ever reported on this row", which is the truth for every row written before
  // this column existed - defaulting those to QUEUED would assert tracking that
  // never happened.
  delivery_status        EmailDeliveryStatus?
  // WHY the row is in its current status, in the provider's own words (bounce
  // description, rejection message). Null on the happy path. Mirrors the sibling
  // SMS channel's messages.status_reason.
  delivery_status_reason String?
  // When delivery_status last changed. Webhooks can arrive out of order, so the
  // handler needs a timestamp to compare against, not just the current value.
  delivery_status_at     DateTime?
  // Set only alongside BOUNCED. DERIVED, not provider-verbatim: Resend reports
  // bounce.type Permanent/Temporary and we map that onto our own hard/soft
  // vocabulary. Carried now so acting on a bounce needs no second migration.
  bounce_kind            EmailBounceKind?
  // Provenance. The SMS channel's `messages.automated` is the precedent this copies (spec #1751
  // D5): the lead contact clock must count a salesperson's own email and must NOT count the
  // appointment confirmation the platform sends on the company's behalf, so the two have to be
  // distinguishable by a value the writer states outright.
  //
  // The tempting alternative is rejected explicitly. Transactional mirrors happen to be written
  // with no `thread_id` while the compose path always populates one, which looks like a free
  // provenance test. It is a CONSEQUENCE of which code path writes the row - documented as such
  // on `thread_id` above - not a contract. The first person to give transactional mail a thread
  // would silently mark every lead in the system contacted.
  //
  // Nullable-with-default, exactly like messages.automated. HISTORICAL ROWS ARE NOT RECOVERABLE
  // FROM THIS COLUMN, and the reading is the PERMISSIVE one rather than the safe one - stated
  // plainly here because an earlier version of this comment claimed the opposite.
  //
  // `ADD COLUMN ... DEFAULT false` backfilled every row that already existed to `false`, and
  // `isHumanOutboundTouch` (services/lead-contact.service.ts) treats `automated !== true` as
  // HUMAN. So every pre-#1751 email - transactional mirrors included - now reads as
  // human-originated on this column alone. Nothing distinguishes them.
  //
  // There is no live consequence, for two reasons that both have to hold. Only rows created by
  // the two writers that state their provenance outright are ever fed to that filter, and each
  // states it at the write site rather than leaning on this default. And the provenance test is
  // not `automated` alone: `direction === 'out'` is required too, which every pre-slice-8b row
  // fails outright (they carry a null direction, and an UNKNOWN direction is not outreach).
  // Reconstructing contact from historical mail is out of scope by D10 and is not attemptable
  // from here; a backfill that wanted it would have to re-derive provenance from `account`.
  automated              Boolean?             @default(false)
  rfc822_message_id      String?
  in_reply_to            String?
  references_header      String?              @db.Text
  cc                     String?
  bcc                    String?
  body_html              String?              @db.Text
  // Email slice 8b: who sent it, stamped once at send by the compose path
  // (req.user!.id) and never changed after. NULLABLE - inbound mail and every
  // system/transactional row (persistTransactionalEmail) has no ServWave
  // sender to stamp, and existing rows predating this column have no reliable
  // source of truth to backfill from (left NULL deliberately, not guessed).
  sent_by_user_id        String?              @db.Uuid
  // Email slice 6 (inbound reply capture) - see InboundMatchState's own comment
  // for why this is stored rather than re-derived. NULL on every outbound row.
  inbound_match          InboundMatchState?
  // The reply token this inbound message arrived on, when it carried a valid
  // one. Kept even for UNMATCHED_SENDER - that is precisely the case where the
  // token resolved but we refused to trust the sender, so retaining it is what
  // turns manual linking into one click instead of a search. NULL when no
  // token was present or it did not resolve.
  reply_token            String?
  // Email slice 6: the DMARC verdict on this inbound message's From header, see
  // InboundAuthVerdict. NULL on every outbound row. Deliberately NOT storing the
  // raw Authentication-Results string alongside it - the verdict is what drives
  // both behaviour and display, and the raw header stays re-fetchable from
  // Resend's Received Emails API by provider_message_id, so a second column
  // would be write-only.
  inbound_auth           InboundAuthVerdict?
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt

  customer         Customer?    @relation(fields: [customer_id], references: [id])
  lead             Lead?        @relation("LeadEmails", fields: [lead_id], references: [id])
  vendor           Vendor?      @relation("VendorEmails", fields: [vendor_id], references: [id])
  job              Job?         @relation("JobEmails", fields: [job_id], references: [id], onDelete: SetNull)
  thread           EmailThread? @relation(fields: [thread_id], references: [id], onDelete: SetNull)
  sent_by          User?        @relation("EmailSentBy", fields: [sent_by_user_id], references: [id], onDelete: SetNull)
  // ON DELETE SET NULL, not Cascade: revoking or pruning a token must never
  // delete the customer's actual message.
  arrived_on_token ReplyToken?  @relation("ReplyTokenInbound", fields: [reply_token], references: [token], onDelete: SetNull)

  // Real uploaded files on a human-composed send (email slice 7) - distinct from
  // the legacy `attachments` Json column above, which only ever carried
  // display-only {name,size} for prototype/mock rows.
  email_attachments EmailAttachment[]
  // Email slice 8c: per-user read state. A row's EXISTENCE means that user has
  // read this message; absence means unread FOR THEM. This - NOT the `unread`
  // column above - is the source of truth for every read path this slice
  // touches (listEmails/getEmail per-row unread, getUnreadCounts, markThreadRead).
  // `unread` is left in place as dead weight for a later cleanup pass (a
  // schema-level DROP COLUMN is a separate, riskier migration than this slice's
  // scope) - nothing this slice touches writes or reads it as truth any more.
  email_read_states EmailReadState[]

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([customer_id])
  @@index([lead_id])
  @@index([vendor_id])
  @@index([job_id])
  @@index([organization_id, thread_id])
  @@index([sent_by_user_id])
  // Email slice 6: the unmatched queue's only query - "inbound mail in this org
  // that did not resolve" - filters on exactly this pair.
  @@index([organization_id, inbound_match])
  @@index([reply_token])
  @@map("emails")
}

// Email slice 8b: the normalised home for per-CONVERSATION workflow state -
// assignee, shared snooze, archive - as distinct from per-MESSAGE attention
// state (EmailReadState, below). Missive's rule this whole slice follows:
// "Assigned to one person, visible to all" - assignment is a routing/ownership
// hint, never a second visibility gate. Anchor-inherited visibility
// (anchorVisibility.ts) still decides who can see a thread at all, riding the
// SAME job/lead precedence as every other comm channel; EmailThread carries no
// job_id/lead_id/customer_id of its own; commParentVisibilityWhere(req,
// 'emails') is the correct way to scope a query against this table (mirrors
// the existing MessageThread/WhatsAppChat parent pattern exactly).
//
// Before this model, Email.thread_id was a bare, FK-less String left over from
// the deleted Gmail integration - nothing wrote it, so there was no
// conversation-level anything to hang assignment off. Backfilled 1:1 (one
// EmailThread per pre-existing Email row - verified against live staging data
// that thread_id was 0/near-0, i.e. no real grouping existed to preserve).
//
// AUTO-UNASSIGN ("owner unreachable"): interpreted minimally, per the approved
// plan - assigned_to.is_active === false. This is NOT stored as a boolean flag
// on the row (that would be a second, driftable source of truth); it is a
// QUERY-TIME condition every read path re-derives from the live User row (see
// effectiveAssigneeId in the controller). A deactivated user's threads read as
// Unassigned everywhere without ever needing a write.
model EmailThread {
  id                  String    @id @default(uuid()) @db.Uuid
  assigned_to_user_id String?   @db.Uuid
  // SHARED (workflow) snooze - one thread, one snooze, visible to whoever can
  // see the thread. Distinct from a PERSONAL snooze, which this slice does not
  // build (not asked for; EmailReadState is where a per-user personal
  // attention state would live if that were ever added).
  snoozed_until       DateTime?
  archived            Boolean   @default(false)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  // ON DELETE SET NULL: a deleted user must not take the thread's history (or
  // the thread row itself) down with them - the thread just reads as
  // Unassigned again, same as the live is_active=false case above.
  assigned_to User?   @relation("EmailThreadAssignee", fields: [assigned_to_user_id], references: [id], onDelete: SetNull)
  emails      Email[]

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])
  reply_tokens    ReplyToken[]

  @@index([organization_id])
  @@index([assigned_to_user_id])
  @@map("email_threads")
}

// Email slice 6 (inbound reply capture): the opaque lookup key that turns
// `<token>@reply.servwave.com` back into a thread.
//
// WHY A LOOKUP KEY AND NOT A SIGNED TOKEN. An earlier draft specified an
// HMAC-signed token carrying org/entity/customer/issued-at inline. That design
// does not fit: RFC 5321 §4.5.3.1.1 caps an email local part at 64 OCTETS, and
// three UUIDs alone are 48 raw bytes = 64 base64url characters before any MAC,
// prefix or separator. So the payload cannot be self-contained. Given that, a
// MAC buys nothing either - a MAC exists to make a SELF-DESCRIBING payload
// tamper-evident, and we are already hitting the database to resolve the
// thread. 128 bits from a CSPRNG is 22 base64url characters and is unguessable
// by construction, which is the only property actually needed.
//
// WHY `<token>@` AND NOT `reply+<token>@`. Plus-addressing is real (RFC 5233
// sub-addressing) and works at the major providers, but `+` is mangled or
// rejected by enough MTAs and hand-rolled address parsers to be a needless
// failure mode. The token as the whole local part on a dedicated subdomain has
// no such problem.
//
// NO PII IN THE ADDRESS, EVER. Reply addresses are logged by every intermediate
// MTA, echoed in DSNs and bounce bodies, and stored in the recipient's mail
// client. An opaque key leaks nothing; a name-derived slug or an encoded
// customer id leaks on every hop. Same rule as never putting personal data in a
// URL query string. (Workiz uses a name-derived slug captioned "Anyone can send
// you emails to this address" - any competitor can construct a given org's
// address. 128 bits of randomness closes that.)
model ReplyToken {
  // 22-char base64url, 128 bits CSPRNG. The PK *is* the secret - there is no
  // separate id, because every lookup is by token and a second key would only
  // create a way for the two to disagree.
  token              String    @id
  organization_id    String    @db.Uuid
  // NULLABLE on purpose. The compose/reply path (email slice 8b) always has a
  // thread, but `persistTransactionalEmail` - every system-generated estimate/
  // invoice/PO notice - creates Email rows with no thread at all, and slice 8b
  // deliberately left that path alone. A token may therefore be anchored to an
  // entity with no thread yet; the inbound handler mints the thread on first
  // reply rather than forcing that deep "never throws" module to mint one on
  // every send.
  thread_id          String?   @db.Uuid
  // What the customer was mailed ABOUT: estimate | invoice | job | lead | customer.
  entity_type        String?
  entity_id          String?   @db.Uuid
  customer_id        String?   @db.Uuid
  // The address we actually sent to, normalized (lowercased, trimmed). The
  // inbound `From` is compared against THIS - see InboundMatchState.
  // UNMATCHED_SENDER. The token authenticates the THREAD, not the person:
  // anyone who can read the email can reply, so a mismatch must route to the
  // manual queue rather than to silent trust.
  expected_from      String
  // Carries assignment attribution into the reply (email slice 8b) - a reply
  // lands with the original sender as its natural owner.
  created_by_user_id String?   @db.Uuid
  // Server-side policy column, NOT baked into the address, so the rule can
  // change without invalidating live addresses already sitting in customers'
  // mailboxes. SETTLED 2026-08-05 (Ran): tokens never expire, so nothing sets
  // this at issue time - it stays null and exists only so a per-token expiry
  // can be imposed later by hand or by policy. Consistent with the standing
  // decision that access does not expire when a job closes. An expired or
  // revoked token routes to the unmatched queue; it must NEVER hard-bounce at
  // the customer.
  expires_at         DateTime?
  revoked_at         DateTime?
  created_at         DateTime  @default(now())

  thread         EmailThread? @relation(fields: [thread_id], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organization_id], references: [id])
  // Inbound messages that arrived addressed to this token.
  inbound_emails Email[]      @relation("ReplyTokenInbound")

  // NO unique constraint on (thread, expected_from), deliberately. Reuse is
  // enforced in the minting helper instead: Postgres treats NULLs as DISTINCT
  // in a unique index, and thread_id/entity_id/customer_id are all nullable
  // here, so a DB-level constraint would silently fail to constrain exactly the
  // rows it looks like it covers. The race it leaves open is benign - two
  // tokens for the same (thread, recipient) both resolve to the same thread.
  @@index([organization_id])
  @@index([thread_id])
  @@index([organization_id, entity_type, entity_id])
  @@map("reply_tokens")
}

// Email slice 8c: per-user read state, replacing Email.unread as the shared
// column that made one person opening a thread mark it read for the whole
// org (the exact bug markThreadRead used to have). Front's rule: attention
// state (read, personal snooze) is PER-USER; workflow state (assignment,
// shared snooze, archive - EmailThread above) is PER-INBOX. Do not merge the
// two back together in a later slice.
//
// A row's EXISTENCE means that (email, user) pair is read; absence means
// unread for that user specifically. No `read: boolean` column and no
// upsert-to-unread path - "unread" is never written, only the read-marker is
// created, so there is exactly one way for this table to disagree with itself.
model EmailReadState {
  id              String   @id @default(uuid()) @db.Uuid
  email_id        String   @db.Uuid
  user_id         String   @db.Uuid
  read_at         DateTime @default(now())
  organization_id String   @db.Uuid

  email        Email        @relation(fields: [email_id], references: [id], onDelete: Cascade)
  user         User         @relation("EmailReadStateUser", fields: [user_id], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organization_id], references: [id])

  @@unique([email_id, user_id])
  @@index([organization_id])
  @@index([user_id])
  @@map("email_read_states")
}

// Real files attached to a human-composed send (email slice 7) - the compose
// window's "attach a file" affordance. `position` fixes display/download order
// (creation order today; nothing reorders after send) - the attachment download
// endpoint indexes into the same [position asc, created_at asc] ordering, so the
// two must never drift.
model EmailAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  email_id     String   @db.Uuid
  file_name    String
  content_type String
  file_size    Int
  storage_path String
  position     Int      @default(0)
  created_at   DateTime @default(now())

  email Email @relation(fields: [email_id], references: [id], onDelete: Cascade)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([email_id])
  @@index([organization_id])
  @@map("email_attachments")
}

// Email slice 4 — Resend delivery webhook idempotency ledger. Global, no org
// column (mirrors CtmEvent/StripeEvent): the owning row is resolved per event
// via emails.provider_message_id, not by a tenant scope, and Resend/svix's own
// event id (the svix-id header) is the dedupe key so a redelivered webhook
// updates once instead of double-applying.
model ResendEvent {
  id              String   @id @default(uuid()) @db.Uuid
  resend_event_id String   @unique
  event_type      String
  payload         Json?
  processed_at    DateTime @default(now())
  created_at      DateTime @default(now())

  @@map("resend_events")
}

// Email slice 4 — global TRANSACTIONAL send-suppression list, written by the
// Resend webhook handler on a HARD bounce or a complaint and read by
// dispatchEmail (lib/email.ts) before every business send. Suppression is by
// bare address ONLY: the sending domain (mail.servwave.com) is shared across
// every org, so a hard-bounced mailbox is broken for every org, not just the
// one whose send triggered it — this must never be scoped to organization_id.
// `organization_id` is carried purely as an audit breadcrumb (which org's send
// first surfaced the bounce/complaint); it is never part of the suppression
// lookup itself. `category` defaults to the only category this codebase has
// today (TRANSACTIONAL) — there is no marketing-send feature anywhere in this
// repo (grepped to confirm) — so a future marketing/newsletter sender could
// suppress independently, under its own category, without a schema change or
// any risk of a newsletter unsubscribe silently blocking a transactional
// invoice.
model EmailSuppression {
  id              String   @id @default(uuid()) @db.Uuid
  address         String
  category        String   @default("TRANSACTIONAL")
  kind            String // "HARD_BOUNCE" | "COMPLAINT"
  organization_id String?  @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([address, category])
  @@map("email_suppressions")
}

model EmailGroup {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  member_ids Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  forward_rules EmailForwardRule[]

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@map("email_groups")
}

model EmailForwardRule {
  id           String   @id @default(uuid()) @db.Uuid
  from         String
  to_group_id  String?  @db.Uuid
  to_member_id String?  @db.Uuid
  enabled      Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  to_group  EmailGroup? @relation(fields: [to_group_id], references: [id])
  to_member User?       @relation("ForwardRuleMember", fields: [to_member_id], references: [id])

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([to_group_id])
  @@index([to_member_id])
  @@map("email_forward_rules")
}

model CallFlow {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  structure    String
  record       Boolean  @default(false)
  status       String
  hours_mode   String
  open_nodes   Json
  closed_nodes Json
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  phone_numbers PhoneNumber[]

  @@index([organization_id])
  @@map("call_flows")
}

// Org-owned tracking/receiving numbers (CTM-purchased or BYO). ctm_number_id is
// the CTM "TPN…" id — SMS `from` + click-to-call `from_number` both take it.
model PhoneNumber {
  id             String   @id @default(uuid()) @db.Uuid
  e164           String
  formatted      String?
  label          String?
  source         String   @default("ctm") // "ctm" | "byo"
  type           String? // "local" | "tollfree"
  capabilities   Json?
  sms_enabled    Boolean  @default(false)
  ctm_number_id  String?
  route_to       Json?
  call_flow_id   String?  @db.Uuid
  status         String   @default("active")
  // Org-level fallback caller ID (comm caller-ID overhaul slice 2): used when the
  // caller has no per-user default. The app enforces <=1 true per org.
  is_org_default Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  call_flow  CallFlow?         @relation(fields: [call_flow_id], references: [id])
  user_links UserPhoneNumber[]

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, e164])
  @@index([organization_id])
  @@index([ctm_number_id])
  @@map("phone_numbers")
}

// Many-to-many User↔PhoneNumber (comm caller-ID overhaul slice 2). A user may
// present any of several org numbers; `is_default` marks that user's default
// outbound caller ID (the app enforces <=1 true per user). The org-level fallback
// lives on PhoneNumber.is_org_default. Numbers bind to user + routing, never role.
model UserPhoneNumber {
  user_id         String   @db.Uuid
  phone_number_id String   @db.Uuid
  is_default      Boolean  @default(false)
  created_at      DateTime @default(now())

  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  phone_number PhoneNumber @relation(fields: [phone_number_id], references: [id], onDelete: Cascade)

  @@id([user_id, phone_number_id])
  @@index([phone_number_id])
  @@map("user_phone_numbers")
}

// Click-to-call attribution stash (comm slice E1): POST /calls (CTM branch)
// writes the picked job/lead/customer context here BEFORE bridging — the CTM
// 'starts'/'end' webhook ingest (lib/ctm/ingest.ts) consumes it within a
// 30-min window via an atomic consumed_at claim when it creates/updates the
// CallSession. Rows are ephemeral: plain UUID columns validated at insert,
// deliberately NO FKs to jobs/leads/customers/users (stale rows expire and are
// swept opportunistically; a deleted entity must never block that).
model PendingCallAttribution {
  id           String    @id @default(uuid()) @db.Uuid
  to_number    String
  job_id       String?   @db.Uuid
  job_label    String?
  lead_id      String?   @db.Uuid
  customer_id  String?   @db.Uuid
  requested_by String?   @db.Uuid
  created_at   DateTime  @default(now())
  consumed_at  DateTime?

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([organization_id, to_number, created_at])
  @@map("pending_call_attributions")
}

model CallGroup {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  ring       String
  members    Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@map("call_groups")
}

model TrainingScenario {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String?
  role_id      String
  title        String
  difficulty   String
  duration_min Int
  script_focus String
  trainer_name String
  persona      String
  steps        Json
  dialogue     Json
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  sessions TrainingSession[]

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@map("training_scenarios")
}

model TrainingSession {
  id             String   @id @default(uuid()) @db.Uuid
  trainee_id     String?  @db.Uuid
  trainee_name   String
  trainee_role   String
  role_id        String
  scenario_id    String?  @db.Uuid
  scenario_slug  String?
  scenario_title String
  difficulty     String
  trainer_name   String
  score          Int?
  outcome        String
  duration_sec   Int
  completed_at   DateTime
  has_recording  Boolean  @default(false)
  coaching_note  String   @db.Text
  transcript     Json?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  scenario TrainingScenario? @relation(fields: [scenario_id], references: [id])
  trainee  User?             @relation("TrainingSessionTrainee", fields: [trainee_id], references: [id])

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([scenario_id])
  @@index([trainee_id])
  @@map("training_sessions")
}

// ─── Copilot (Servy) — in-CRM voice + text AI copilot ───
// Conversations + messages are organization+user scoped (user-private). Audit
// events are content-free and deliberately have NO conversation FK so they
// survive a conversation hard-delete. organization_id / user_id are scalar
// columns (no relation back to Organization / User) to keep this module
// self-contained — see migration 20260610140000_add_copilot_tables.
model CopilotConversation {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  user_id         String   @db.Uuid
  title           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  messages CopilotMessage[]

  @@index([organization_id, user_id])
  @@map("copilot_conversations")
}

model CopilotMessage {
  id              String           @id @default(uuid()) @db.Uuid
  conversation_id String           @db.Uuid
  organization_id String           @db.Uuid
  user_id         String           @db.Uuid
  role            CopilotRole
  modality        CopilotModality
  content         String           @db.Text
  status          CopilotMsgStatus @default(FINAL)
  label_key       String?
  capability_id   String?
  execution_mode  String?
  meta            Json?
  feedback        String?
  created_at      DateTime         @default(now())

  conversation CopilotConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([organization_id, user_id])
  @@map("copilot_messages")
}

model CopilotAuditEvent {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  user_id         String   @db.Uuid
  ts              DateTime @default(now())
  event_type      String
  capability_id   String?
  execution_mode  String?
  allowed         Boolean
  reason          String?

  @@index([organization_id, user_id])
  @@map("copilot_audit_events")
}

enum CopilotRole {
  USER
  ASSISTANT
}

enum CopilotModality {
  TEXT
  VOICE
}

enum CopilotMsgStatus {
  FINAL
  STOPPED
  FALLBACK
}

// ===========================================================================
// Timeclock module — GPS-gated punch clock with geofencing + OT review
// ===========================================================================

enum PunchType {
  IN
  OUT
}

enum PunchZoneKind {
  STORE
  JOB
}

enum PunchStatus {
  IN_ZONE
  OVERRIDE
}

enum PunchReview {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum OtReviewState {
  APPROVED
  REJECTED
}

/// Append-only punch log. One row per clock-in / clock-out event.
model TimeEntry {
  id                 String         @id @default(uuid()) @db.Uuid
  organization_id    String         @db.Uuid
  user_id            String         @db.Uuid
  type               PunchType
  ts                 DateTime       @db.Timestamptz
  lat                Float
  lng                Float
  accuracy_m         Float?
  matched_zone_id    String?
  matched_zone_label String?
  matched_zone_kind  PunchZoneKind?
  matched_job_number String?
  distance_m         Float?
  status             PunchStatus
  review             PunchReview    @default(NONE)
  reviewed_by        String?        @db.Uuid // user id of the approver; plain column, no relation
  reviewed_at        DateTime?      @db.Timestamptz
  created_at         DateTime       @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])
  user         User         @relation("TimeEntryUser", fields: [user_id], references: [id])

  @@index([organization_id, user_id, ts])
  @@index([organization_id, review])
  @@map("time_entries")
}

/// Per-org singleton geofence configuration (radius applied to all zones).
model GeofenceConfig {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @unique @db.Uuid
  radius_m        Int      @default(150)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])

  @@map("geofence_configs")
}

/// Multi-store geofence zones (store/branch locations a tech can punch from).
model GeofenceStore {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  label           String
  lat             Float
  lng             Float
  created_at      DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@map("geofence_stores")
}

// --- Tasks module ---
enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskEntity {
  JOB
  LEAD
  CUSTOMER
  ESTIMATE
}

enum TaskSource {
  MANUAL
  AI_NL
  AI_TEMPLATE
  AI_EXTRACT
}

model Task {
  id                 String       @id @default(uuid()) @db.Uuid
  task_number        String
  title              String
  description        String       @default("")
  status             TaskStatus   @default(TODO)
  priority           TaskPriority @default(MEDIUM)
  // Flat set of people doing the task. No primary/accountable-one by design.
  // Invariant enforced in the API layer, not the DB: a live task always has >= 1.
  assignee_ids       String[]     @default([]) @db.Uuid
  due_at             DateTime?
  linked_entity_type TaskEntity?
  linked_entity_id   String?      @db.Uuid
  tags               String[]     @default([])
  watcher_ids        String[]     @default([]) @db.Uuid
  ai_source          TaskSource   @default(MANUAL)
  ai_suggested_by    String?
  created_by         String       @db.Uuid
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
  completed_at       DateTime?
  organization_id    String       @db.Uuid

  // No relation for assignee_ids/watcher_ids: Postgres arrays carry no FK, so nothing in
  // the DATABASE removes a deactivated user's id from either. lib/tasks/deactivation.ts
  // does it in the application layer on the `is_active -> false` transition; readers still
  // resolve names by id lookup and tolerate a miss, for the rows a sweep could not repair.
  creator      User          @relation("TaskCreatedBy", fields: [created_by], references: [id])
  organization Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  subtasks     TaskSubtask[]

  @@unique([organization_id, task_number])
  @@index([organization_id])
  @@index([linked_entity_type, linked_entity_id])
  // GIN: every visibility query filters `assignee_ids has me OR watcher_ids has me`.
  @@index([assignee_ids], type: Gin)
  @@index([watcher_ids], type: Gin)
  @@map("tasks")
}

model TaskSubtask {
  id         String   @id @default(uuid()) @db.Uuid
  task_id    String   @db.Uuid
  text       String
  done       Boolean  @default(false)
  position   Int      @default(0)
  created_at DateTime @default(now())
  task       Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@map("task_subtasks")
}

// --- Calendar Entries (Slice 02, spec §2/§4/§7/§8; user-facing "Events") ---
// A CalendarEntry is scheduler content that is not work: a pre-lead customer meeting, an
// org-wide notice ("Dave is off Thursday"). It joins nothing (ADR 0002) - no lead/job/estimate
// FK, no crew, no record number (SchedulableEvent.number is satisfied by '' in the board
// adapter, Slice 03). organization_id and created_by are plain columns with no Prisma relation
// (mirrors TimeClockOtReview.reviewed_by) to keep this table self-contained and avoid widening
// User/Organization with back-relation arrays for a subject with no ownership chain.
//
// rrule/recurrence_until are RESERVED: written null, never read, never accepted by the create/
// update zod schemas and never selected into a response (see calendar-entry.controller.ts).
// Two nullable columns now make recurrence an additive change later instead of a migration
// against live rows (spec §2, §8 - recurrence expansion is permanently out).
model CalendarEntry {
  id               String    @id @default(uuid()) @db.Uuid
  organization_id  String    @db.Uuid // plain column, RLS-scoped; no relation - see header note
  title            String
  description      String    @default("")
  start            DateTime
  end              DateTime
  is_all_day       Boolean   @default(false)
  rrule            String? // RESERVED - see header note; never read, never API-writable
  recurrence_until DateTime? // RESERVED - see header note; never read, never API-writable
  created_by       String    @db.Uuid // creator user id; plain column, no relation - the creator is NOT a participant (spec §2)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  participants CalendarEntryParticipant[]

  @@index([organization_id])
  @@index([organization_id, start, end])
  @@map("calendar_entries")
}

enum CalendarParticipantKind {
  USER
  CUSTOMER
}

// Participants are optional and mixed (0..N users, 0..N customers); a zero-participant entry
// is normal and expected (spec §2). Carries its own organization_id - not derivable at the row
// level without a join, and the tenant_isolation RLS backstop is per-table - mirroring
// NotificationRecipient, which carries organization_id for the same reason. user_id/customer_id
// are plain columns with no Prisma relation (also mirrors NotificationRecipient.recipient_id);
// the controller verifies both belong to the caller's org before insert (org-validated FK
// guard, same pattern as inv-stages.controller.ts's validateJobAndCustomer).
model CalendarEntryParticipant {
  id                String                  @id @default(uuid()) @db.Uuid
  organization_id   String                  @db.Uuid // plain column - see header note
  calendar_entry_id String                  @db.Uuid
  kind              CalendarParticipantKind
  user_id           String?                 @db.Uuid // plain column, no relation - see header note
  customer_id       String?                 @db.Uuid // plain column, no relation - see header note
  notified_at       DateTime? // unwritten in this slice - Slice 07 (notifications)

  calendar_entry CalendarEntry @relation(fields: [calendar_entry_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([calendar_entry_id])
  @@map("calendar_entry_participants")
}

/// Per-week overtime approval, one row per (user, ISO-week) period.
model TimeClockOtReview {
  id              String        @id @default(uuid()) @db.Uuid
  organization_id String        @db.Uuid
  user_id         String        @db.Uuid
  period_key      String // org-local ISO week key, e.g. "2026-W24"
  state           OtReviewState
  reviewed_by     String        @db.Uuid // approver user id; plain column, no relation
  reviewed_at     DateTime      @default(now()) @db.Timestamptz
  created_at      DateTime      @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])
  user         User         @relation("OtReviewUser", fields: [user_id], references: [id])

  @@unique([organization_id, user_id, period_key])
  @@index([organization_id])
  @@map("timeclock_ot_reviews")
}

// ============================================================================
// IN-APP NOTIFICATIONS
// ============================================================================

enum NotificationCategory {
  LEAD
  ESTIMATE
  DISPATCH
  JOB
  BILLING
  TASK
  TEAM
  INVENTORY
  SECURITY
  SERVICE_PLAN
  COMMUNICATION
}

enum NotificationPriority {
  INTERRUPT
  FEED
}

model Notification {
  id              String                  @id @default(uuid()) @db.Uuid
  organization_id String                  @db.Uuid
  organization    Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  actor_id        String?                 @db.Uuid
  verb            String
  category        NotificationCategory
  priority        NotificationPriority
  needs_action    Boolean                 @default(false)
  object_type     String
  object_id       String
  object_label    String?
  title           String
  body            String?
  data            Json                    @default("{}")
  action_type     String?
  dedup_key       String?
  group_key       String?
  created_at      DateTime                @default(now())
  recipients      NotificationRecipient[]

  @@unique([organization_id, dedup_key])
  @@index([organization_id, created_at])
  @@map("notifications")
}

model NotificationRecipient {
  id              String               @id @default(uuid()) @db.Uuid
  notification_id String               @db.Uuid
  notification    Notification         @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  organization_id String               @db.Uuid
  recipient_id    String               @db.Uuid
  priority        NotificationPriority
  needs_action    Boolean              @default(false)
  seen_at         DateTime?
  read_at         DateTime?
  acted_at        DateTime?
  dismissed_at    DateTime?
  created_at      DateTime             @default(now())

  @@index([recipient_id, read_at, created_at])
  @@index([recipient_id, seen_at])
  @@index([notification_id])
  @@map("notification_recipients")
}

// --- Legal: in-app ToS + Privacy acceptance (SERV10X-17) ---
// Append-only, self-contained (no FKs, like AuditLog) so the record survives a
// user deletion. organization_id is a plain column keyed by the tenant_isolation
// RLS policy. Written by POST /api/auth/accept-invite (runs unscoped → bypass RLS).
model TermsAcceptance {
  id                 String   @id @default(uuid()) @db.Uuid
  user_id            String   @db.Uuid
  user_email         String
  organization_id    String   @db.Uuid
  terms_version      String
  terms_url          String
  privacy_url        String
  context            String   @default("invite_acceptance")
  ip_address         String?
  user_agent         String?
  disclosed_fee_bps  Int? // rate snapshot the admin saw at acceptance (payments_onboarding only)
  authority_attested Boolean  @default(false) // "I'm authorized to bind {org}" checkbox
  accepted_at        DateTime @default(now()) @db.Timestamptz(6)

  @@index([organization_id])
  @@index([user_id])
  @@map("terms_acceptances")
}

// Org-wide security/compliance audit trail. Distinct from TimelineEvent (per-entity
// activity feed) and Notification (in-app alerts): this captures who/where/when for
// security-relevant actions, including auth events, IP and user-agent. Append-only.
//
// Intentionally has NO foreign keys / relations: audit history must survive deletion
// of the actor or referenced entity, and we preserve the raw actor_id for forensics
// (mirrors notifications.actor_id, which is also FK-less). org_id/actor_id are always
// supplied by trusted backend code (authenticated session or resolved entity).
//
// Written ONLY by the backend via Prisma (direct Postgres, RLS-bypassing role). The
// migration also enables RLS with a SELECT-only own-org policy as defense-in-depth.
model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        String   @db.Uuid
  actor_id      String?  @db.Uuid
  actor_email   String?
  action        String
  resource_type String?
  resource_id   String?
  metadata      Json     @default("{}")
  ip_address    String?
  user_agent    String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([org_id, created_at(sort: Desc)])
  @@index([actor_id, created_at(sort: Desc)])
  @@index([action])
  @@index([resource_type, resource_id])
  @@map("audit_logs")
}

// ─── Automation Center ────────────────────────────────────────────────────────
// Org-scoped automation rules: event triggers (dispatched post-commit from
// controllers) + time-based triggers (60s poller). Every fire is an
// AutomationRun row; the (rule_id, dedupe_key) unique IS the idempotency
// mechanism (event re-dispatch / poller overlap collapse into a no-op insert).
// Spec: md_files/specs/automations/automation-center-spec.md

enum AutomationTriggerType {
  // events
  JOB_SCHEDULED
  JOB_RESCHEDULED
  TECH_ASSIGNED
  JOB_COMPLETED
  JOB_CANCELLED
  ESTIMATE_SENT
  ESTIMATE_APPROVED
  ESTIMATE_DECLINED
  INVOICE_SENT
  INVOICE_PAID
  LEAD_CREATED
  LEAD_ASSIGNED
  WALKTHROUGH_SCHEDULED
  WALKTHROUGH_RESCHEDULED
  WALKTHROUGH_COMPLETED
  WALKTHROUGH_CANCELLED
  WALKTHROUGH_PERFORMER_ASSIGNED
  WALKTHROUGH_PERFORMER_REMOVED
  TECH_UNASSIGNED
  JOB_EN_ROUTE
  JOB_SUB_STATUS_ENTERED
  // time-based
  BEFORE_JOB_START
  AFTER_JOB_COMPLETED
  INVOICE_OVERDUE
  ESTIMATE_FOLLOW_UP
  // date-anchored (unified before/after a date)
  JOB_DATE_ANCHORED
  LEAD_DATE_ANCHORED
  INVOICE_DATE_ANCHORED
  ESTIMATE_DATE_ANCHORED
}

enum AutomationActionType {
  SEND_EMAIL
  SEND_SMS
  NOTIFY_TEAM
}

enum AutomationSendWindow {
  ANYTIME
  BUSINESS_HOURS
}

enum AutomationRunStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

model AutomationRule {
  id             String                @id @default(uuid()) @db.Uuid
  name           String
  is_enabled     Boolean               @default(true)
  trigger_type   AutomationTriggerType
  // { offset_minutes: number } for time-based triggers; null for event triggers
  trigger_config Json?
  action_type    AutomationActionType
  // SEND_EMAIL: { recipient, custom_email?, subject, body }
  // SEND_SMS:   { recipient: 'customer', body }
  // NOTIFY_TEAM:{ recipient, user_id?, body }
  action_config  Json
  send_window    AutomationSendWindow  @default(ANYTIME)
  // gallery provenance (e.g. 'reminder-24h'); null for from-scratch rules
  template_key   String?

  created_by_id String? @db.Uuid
  created_by    User?   @relation("AutomationRuleCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)

  last_triggered_at DateTime?
  trigger_count     Int       @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  runs AutomationRun[]

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([organization_id, trigger_type])
  @@index([organization_id])
  @@map("automation_rules")
}

model AutomationRun {
  id      String              @id @default(uuid()) @db.Uuid
  rule_id String              @db.Uuid
  rule    AutomationRule      @relation(fields: [rule_id], references: [id], onDelete: Cascade)
  status  AutomationRunStatus @default(PENDING)

  // polymorphic anchor: 'job' | 'estimate' | 'invoice' | 'lead'
  entity_type  String
  entity_id    String  @db.Uuid
  entity_label String?

  // occurrence identity — see spec §3 (reschedule-correctness lives here)
  dedupe_key String

  fire_at     DateTime
  executed_at DateTime?

  // "sarah@acme.com" / "3 team members" — human-readable destination
  recipient_summary String?
  // plain-English skip/fail reason, or subject preview on success
  detail            String?

  created_at DateTime @default(now())

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([rule_id, dedupe_key])
  @@index([organization_id, status, fire_at])
  // The poller's hot query is cross-org: WHERE status='PENDING' AND fire_at<=now
  // ORDER BY fire_at. The org-leading index above can't serve it, so index the
  // scan predicate directly to keep every-minute execution off a seq scan.
  @@index([status, fire_at])
  @@index([rule_id, created_at])
  @@index([organization_id, created_at])
  @@map("automation_runs")
}

// ─── Workflow Builder (Automation Center v2) ──────────────────────────────────
// Multi-step successor to AutomationRule/AutomationRun above (untouched — the
// legacy engine keeps running through the migration). A Workflow is drafted as
// WorkflowStep[] (ordered, mutable) and published as an immutable
// WorkflowVersion snapshot; entities enroll into a published version
// (WorkflowEnrollment) and step through it, one WorkflowStepRun per step.
// Schema-only foundation (Task 1) — engine/controller code lands separately.

enum WorkflowStatus {
  DRAFT
  PUBLISHED
}

enum WorkflowStepType {
  WAIT
  SEND_TEXT
  SEND_EMAIL
  NOTIFY_TEAM
  STOP_IF
}

enum WorkflowEnrollmentStatus {
  ACTIVE
  COMPLETED
  STOPPED
  FAILED
}

enum WorkflowStepRunStatus {
  SENT
  SKIPPED
  FAILED
  STOPPED
  CONTINUED
}

model Workflow {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  status               WorkflowStatus        @default(DRAFT)
  is_enabled           Boolean               @default(false)
  trigger_type         AutomationTriggerType
  trigger_config       Json?
  send_window          AutomationSendWindow  @default(ANYTIME)
  template_key         String?
  /**
   * Identity for the org's copy of a seeded built-in automation (e.g.
   * 'job-scheduled-confirmation') — distinct from template_key, which records
   * PROVENANCE ("copied from this gallery template") and can't carry a
   * uniqueness constraint since one template may be copied more than once.
   * builtin_key answers a different question: "is this THE org's copy of
   * built-in X" — set once at seed time (defaultAutomations.ts), read only to
   * make the seeder idempotent and to detect an org that deleted/kept theirs.
   * Null for every ordinary, builder-authored workflow.
   */
  builtin_key          String?
  legacy_rule_id       String?               @db.Uuid
  published_version_id String?               @db.Uuid
  published_at         DateTime?
  last_triggered_at    DateTime?
  trigger_count        Int                   @default(0)
  created_by_id        String?               @db.Uuid
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt
  organization_id      String                @db.Uuid

  steps       WorkflowStep[]
  versions    WorkflowVersion[]
  enrollments WorkflowEnrollment[]

  // NULLs never collide under a unique index (Postgres treats each NULL as
  // distinct), so ordinary workflows (builtin_key: null) are never subject to
  // this constraint — it only ever fires for two rows sharing the same real key.
  @@unique([organization_id, builtin_key])
  @@index([organization_id, trigger_type, is_enabled])
  @@index([organization_id])
  @@map("workflows")
}

model WorkflowStep {
  id              String           @id @default(uuid()) @db.Uuid
  workflow_id     String           @db.Uuid
  position        Int
  step_type       WorkflowStepType
  config          Json
  organization_id String           @db.Uuid

  workflow Workflow @relation(fields: [workflow_id], references: [id], onDelete: Cascade)

  @@unique([workflow_id, position])
  @@index([workflow_id])
  @@map("workflow_steps")
}

model WorkflowVersion {
  id              String   @id @default(uuid()) @db.Uuid
  workflow_id     String   @db.Uuid
  version         Int
  definition      Json
  published_at    DateTime @default(now())
  published_by_id String?  @db.Uuid
  organization_id String   @db.Uuid

  workflow    Workflow             @relation(fields: [workflow_id], references: [id], onDelete: Cascade)
  enrollments WorkflowEnrollment[]

  @@unique([workflow_id, version])
  @@map("workflow_versions")
}

model WorkflowEnrollment {
  id                  String                   @id @default(uuid()) @db.Uuid
  workflow_id         String                   @db.Uuid
  workflow_version_id String                   @db.Uuid
  status              WorkflowEnrollmentStatus @default(ACTIVE)

  entity_type    String
  entity_id      String  @db.Uuid
  entity_label   String?
  occurrence_key String?
  dedupe_key     String

  step_cursor     Int       @default(0)
  resume_at       DateTime
  started_at      DateTime  @default(now())
  finished_at     DateTime?
  finished_reason String?

  /**
   * Anything the triggering event captured that the live entity can't
   * reproduce later — e.g. the removed user this run should message (their id
   * no longer appears on the job/lead once they're off it), or free-text like
   * a cancellation reason. Read into ExecutionBundle.mergeCtx / .eventRecipient
   * at every step (context.ts), so it survives a WAIT of any length.
   */
  event_payload Json?

  organization_id String @db.Uuid

  workflow  Workflow          @relation(fields: [workflow_id], references: [id], onDelete: Cascade)
  version   WorkflowVersion   @relation(fields: [workflow_version_id], references: [id])
  step_runs WorkflowStepRun[]

  @@unique([workflow_id, dedupe_key])
  @@index([status, resume_at])
  @@index([organization_id, status, started_at])
  @@map("workflow_enrollments")
}

model WorkflowStepRun {
  id                String                @id @default(uuid()) @db.Uuid
  enrollment_id     String                @db.Uuid
  step_index        Int
  step_type         WorkflowStepType
  status            WorkflowStepRunStatus
  executed_at       DateTime?
  recipient_summary String?
  detail            String?
  created_at        DateTime              @default(now())
  organization_id   String                @db.Uuid

  enrollment WorkflowEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)

  @@unique([enrollment_id, step_index])
  @@index([organization_id, created_at])
  @@map("workflow_step_runs")
}
