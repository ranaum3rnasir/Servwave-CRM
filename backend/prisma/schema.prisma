  customer         Customer                  @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  service_location ServiceLocation           @relation(fields: [service_location_id], references: [id], onDelete: Restrict)
  sold_by_user     User?                     @relation("ServicePlanSoldBy", fields: [sold_by], references: [id], onDelete: SetNull)
  template         ServicePlanTemplate?      @relation(fields: [template_id], references: [id], onDelete: SetNull)
  line_items       ServicePlanLineItem[]
  material_lines   ServicePlanMaterialLine[]
  visits           PlanVisit[]
  invoices         Invoice[]
  jobs             Job[]
  logistic_orders  LogisticOrder[]           @relation("LogisticOrderServicePlan")

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, service_plan_number])
  @@index([customer_id])
  @@index([service_location_id])
  @@index([status])
  @@index([organization_id])
  @@map("service_plans")
}

