  invoice_line_item InvoiceLineItem? @relation("StockMovementInvoiceLine", fields: [invoice_line_item_id], references: [id], onDelete: SetNull)
  actor_user        User?            @relation("StockMovementActor", fields: [actor_user_id], references: [id], onDelete: SetNull)

  logistic_order      LogisticOrder?     @relation("StockMovementLogisticOrder", fields: [logistic_order_id], references: [id], onDelete: SetNull)
  logistic_order_line LogisticOrderLine? @relation("StockMovementLogisticOrderLine", fields: [logistic_order_line_id], references: [id], onDelete: SetNull)

