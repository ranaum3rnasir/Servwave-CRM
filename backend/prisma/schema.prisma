generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String                @id @default(uuid()) @db.Uuid
  email                       String                @unique
  password_hash               String                @default("")
  first_name                  String
  last_name                   String
  // SRVW-138: `role` is the BASE role. When custom_role_id is set the user's GRANTS come
  // from the custom role (lib/permissions/effectiveRole.ts grantRoleKey), but every code
  // branch asking "what kind of user is this" still reads `role`.
  role                        Role
  custom_role_id              String?               @db.Uuid
  custom_role                 CustomRole?           @relation(fields: [custom_role_id], references: [id], onDelete: SetNull)
  is_active                   Boolean               @default(true)
  has_login                   Boolean               @default(true)
  mfa_email_enrolled          Boolean               @default(false)
  enforce_clock_in_location   Boolean               @default(true)
  can_approve_clock_overrides Boolean               @default(false)
  phone                       String?
  phone_ext                   String?
  avatar_path                 String?               @db.Text
  department_id               String?               @db.Uuid
  location_id                 String?               @db.Uuid
  created_at                  DateTime              @default(now())
  updated_at                  DateTime              @updatedAt
  department                  Department?           @relation(fields: [department_id], references: [id], onDelete: SetNull)
  location                    Location?             @relation("UserLocation", fields: [location_id], references: [id], onDelete: SetNull)
  managed_locations           Location[]            @relation("LocationManager")
  headed_departments          Department[]          @relation("DepartmentHead")
  uploaded_attachments        Attachment[]          @relation("AttachmentUploadedBy")
  created_estimates           Estimate[]            @relation("EstimateCreatedBy")
  cancelled_visits            Visit[]               @relation("VisitCancelledBy")
  created_notes               Note[]                @relation("NoteCreatedBy")
  collected_payments          Payment[]             @relation("PaymentCollectedBy")
  timeline_events             TimelineEvent[]       @relation("TimelineCreatedBy")
  refunded_invoices           Invoice[]             @relation("InvoiceRefundedBy")
  table_preferences           UserTablePreference[]

  // --- Entity-redesign §8 money model (additive) ---
  issued_refunds  Refund[]  @relation("RefundRefundedBy")
  created_credits Credit[]  @relation("CreditCreatedBy")
  voided_payments Payment[] @relation("PaymentVoidedBy")

  // --- Emanuel inventory/comms unified back-relations ---
  primary_tech_locations    InventoryLocation[] @relation("LocationPrimaryTech")
  stock_movements_performed StockMovement[]     @relation("StockMovementActor")
  assigned_job_stages       JobStage[]          @relation("JobStageAssignedTech")
  requested_approvals       StockApproval[]     @relation("ApprovalRequestedByTech")
  reviewed_approvals        StockApproval[]     @relation("ApprovalReviewedBy")
  answered_calls            CallSession[]       @relation("CallSessionAgent")
  phone_agent               PhoneAgent?
  phone_numbers             UserPhoneNumber[]
  blocked_numbers_created   BlockedNumber[]     @relation("BlockedNumberBy")
  email_forward_rules       EmailForwardRule[]  @relation("ForwardRuleMember")
  // --- Email slice 8b/8c: thread assignment + per-user read state ---
  email_threads_assigned    EmailThread[]       @relation("EmailThreadAssignee")
  emails_sent               Email[]             @relation("EmailSentBy")
  email_read_states         EmailReadState[]    @relation("EmailReadStateUser")
  training_sessions         TrainingSession[]   @relation("TrainingSessionTrainee")
  assets_held               Asset[]             @relation("AssetAssignedUser")
  asset_events              AssetEvent[]        @relation("AssetEventUser")
  asset_events_acted        AssetEvent[]        @relation("AssetEventByUser")

  // --- Logistic Orders: four distinct actor seats on the same document ---
  logistic_orders_created   LogisticOrder[] @relation("LogisticOrderCreatedBy")
  logistic_orders_submitted LogisticOrder[] @relation("LogisticOrderSubmittedBy")
  logistic_orders_approved  LogisticOrder[] @relation("LogisticOrderApprovedBy")
  logistic_orders_processed LogisticOrder[] @relation("LogisticOrderProcessedBy")

  // --- Scheduler redesign: assignment M2M back-relations (additive) ---
  lead_crew_memberships  LeadAssignee[]  @relation("LeadAssigneeUser")
  visit_assignments      VisitAssignee[] @relation("VisitAssigneeUser")
  commission_owned_leads Lead[]          @relation("LeadCommissionOwner")
  created_jobs           Job[]           @relation("JobCreator")
  dispatched_jobs        Job[]           @relation("JobDispatcher")
  jobs_as_salesperson    Job[]           @relation("JobSalesperson")
  // --- Creator tracking back-relations (audit only; nothing reads them for authorization) ---
  created_leads          Lead[]          @relation("LeadCreator")
  // Back-relation for the hand-set contact correction (spec #1751 D5) — audit only, like the
  // creator relations around it. See Lead.contacted_set_by for why the relation is declared.
  leads_contact_set      Lead[]          @relation("LeadContactSetter")
  created_invoices       Invoice[]       @relation("InvoiceCreator")
  created_customers      Customer[]      @relation("CustomerCreator")
  created_payments       Payment[]       @relation("PaymentCreator")
  created_attachments    Attachment[]    @relation("AttachmentCreator")
  // --- Service Plans ---
  service_plans_sold     ServicePlan[]   @relation("ServicePlanSoldBy")

  // --- Timeclock module ---
  time_entries         TimeEntry[]         @relation("TimeEntryUser")
  timeclock_ot_reviews TimeClockOtReview[] @relation("OtReviewUser")

  // --- Email-OTP 2FA ---
  mfa_email_challenges MfaEmailChallenge[] @relation("MfaChallengeUser")

  // --- Per-user permission overrides (allow/deny on top of the role grant) ---
  permission_overrides UserPermissionOverride[] @relation("UserPermissionOverrideUser")

  // --- Tasks module ---
  tasks_created Task[] @relation("TaskCreatedBy")

  // --- Automation Center ---
  automation_rules_created AutomationRule[] @relation("AutomationRuleCreatedBy")

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([custom_role_id])
  @@index([department_id])
  @@index([location_id])
  @@index([organization_id])
  @@map("users")
}

// --- Email-OTP 2FA ---
enum MfaChallengePurpose {
  LOGIN
  ENROLL
}

model MfaEmailChallenge {
  id                String              @id @default(uuid()) @db.Uuid
  user_id           String              @db.Uuid
  user              User                @relation("MfaChallengeUser", fields: [user_id], references: [id], onDelete: Cascade)
  code_hmac         String
  enc_refresh_token String? // null for ENROLL challenges
  purpose           MfaChallengePurpose @default(LOGIN)
  attempts          Int                 @default(0)
  expires_at        DateTime
  consumed_at       DateTime?
  created_at        DateTime            @default(now())

  @@index([user_id])
  @@index([expires_at])
  @@map("mfa_email_challenge")
}

model Department {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  head_id    String?  @db.Uuid // display-only manager; grants NO powers
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  users      User[]
  head       User?    @relation("DepartmentHead", fields: [head_id], references: [id], onDelete: SetNull)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, name])
  @@index([organization_id])
  @@index([head_id])
  @@map("departments")
}

model LeadAssignee {
  id              String       @id @default(uuid()) @db.Uuid
  lead_id         String       @db.Uuid
  user_id         String       @db.Uuid
  organization_id String       @db.Uuid
  created_at      DateTime     @default(now())
  lead            Lead         @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  user            User         @relation("LeadAssigneeUser", fields: [user_id], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([lead_id, user_id])
  @@index([user_id])
  @@index([organization_id])
  @@map("lead_assignees")
}

// Multi-visit spec slice S1 (D6): the walkthrough-performer join, renamed to visit_assignees and
// repointed at `visits`. This is the table the JOB-assignee join folds into in slice S3, at which
// point "the job's crew" becomes a derived union over its visits.
//
// `lead_id` is GONE as of slice S8, alongside the job_assignees drop. S3 kept it because seven
// select sites read Lead's `visit_assignees` back-relation directly - two of them (in
// attachment.controller) being ACCESS decisions rather than rendering - and dropping it before
// they moved would have been a permission hole. All seven now traverse `lead.visits[].assignees`,
// and the projected wire key `visit_assignees` on the lead payload is unchanged.
//
// The unique constraint keys on (visit_id, user_id), NOT (lead_id, user_id): the same person can
// be on a SECOND visit for the same lead, which is precisely the shape multi-visit needs.
model VisitAssignee {
  id              String       @id @default(uuid()) @db.Uuid
  user_id         String       @db.Uuid
  organization_id String       @db.Uuid
  visit_id        String       @db.Uuid
  created_at      DateTime     @default(now())
  user            User         @relation("VisitAssigneeUser", fields: [user_id], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organization_id], references: [id])
  visit           Visit        @relation(fields: [visit_id], references: [id], onDelete: Cascade)

  @@unique([visit_id, user_id])
  @@index([user_id])
  @@index([organization_id])
  @@map("visit_assignees")
}

model Location {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  name            String   @db.VarChar(120)
  code            String?  @db.VarChar(20)
  address_line1   String?  @db.VarChar(200)
  address_line2   String?  @db.VarChar(200)
  city            String?  @db.VarChar(100)
  state           String?  @db.VarChar(50)
  postal_code     String?  @db.VarChar(20)
  country         String?  @default("US") @db.VarChar(2)
  timezone        String?  @db.VarChar(64)
  phone           String?  @db.VarChar(50)
  manager_id      String?  @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  manager      User?        @relation("LocationManager", fields: [manager_id], references: [id], onDelete: SetNull)
  members      User[]       @relation("UserLocation")

  @@unique([organization_id, code])
  @@index([organization_id])
  @@map("locations")
}

model Customer {
  id                  String   @id @default(uuid()) @db.Uuid
  customer_number     String   @db.VarChar(20)
  // Editable record IDs (Workiz dual-run) — see numbering.ts self-heal + rename transaction.
  number_is_custom    Boolean  @default(false)
  original_number     String?
  estimate_seq        Int      @default(0) // SERV10X-61 - per-customer estimate container counter (C00010-1)
  email               String?
  phone               String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  ad_source           String?
  allow_billing       Boolean  @default(false)
  company_name        String?
  first_name          String?
  last_name           String?
  phone_ext           String?
  secondary_phone     String?
  secondary_phone_ext String?
  tax_exempt          Boolean  @default(false)
  payment_type        String?

  // --- Entity-redesign §2/§10. Legacy fields above (ad_source, phone*, secondary_phone*, allow_billing, payment_type) are KEPT (deferred drop — FE-coupled / data-quality) ---
  kind                  CustomerKind
  segment               CustomerSegment
  parent_id             String?         @db.Uuid
  bill_to_customer_id   String?         @db.Uuid
  billing_address_line1 String?
  billing_address_line2 String?
  billing_city          String?
  billing_state         String?
  billing_zip           String?
  billing_terms         String?
  source                String?
  notes                 String?
  is_active             Boolean         @default(true)
  archived_at           DateTime?
  is_parent             Boolean         @default(false)
  // --- Custom Fields (SRVW-114): { "<definition-uuid>": <scalar> } ---
  custom_fields         Json            @default("{}")

  jobs              Job[]
  leads             Lead[]
  service_locations ServiceLocation[]
  extra_emails      CustomerEmail[]
  phones            CustomerPhone[]
  invoices          Invoice[]
  service_plans     ServicePlan[]
  // R6 (2026-07-22) — direct anchor mirroring Job.customer_id; see Estimate.customer_id.
  estimates         Estimate[]
  parent            Customer?         @relation("CustomerParent", fields: [parent_id], references: [id], onDelete: SetNull)
  members           Customer[]        @relation("CustomerParent")
  bill_to           Customer?         @relation("CustomerBillTo", fields: [bill_to_customer_id], references: [id], onDelete: SetNull)
  billed_customers  Customer[]        @relation("CustomerBillTo")

  // --- Emanuel comms/inventory unified back-relations ---
  membership_tier       String?
  sla_profile           String?
  call_sessions         CallSession[]
  message_threads       MessageThread[]
  whatsapp_chats        WhatsAppChat[]
  emails                Email[]
  contacts              Contact[]
  rfqs                  Rfq[]
  estimate_reservations EstimateReservation[]
  purchase_orders       PurchaseOrder[]
  job_stages            JobStage[]
  stock_approvals       StockApproval[]
  logistic_orders       LogisticOrder[]       @relation("LogisticOrderCustomer")

  // --- Creator tracking (audit only). NOTHING reads these for authorization. ---
  // Immutable, written once at create. Same shape and rationale as Job (see that model for the full
  // note): SetNull rather than Restrict so DELETE /api/users/:id/permanent stays possible, with
  // created_by_name as the snapshot that keeps the audit answer readable once the user row is gone,
  // and UNKNOWN as the honest default for the rows that predate the column.
  // -> md_files/specs/permissions/2026-08-04-technician-ownership-and-creator-tracking.md (Part A)
  created_by_id     String?         @db.Uuid
  created_by_name   String?
  created_by_source CreatedBySource @default(UNKNOWN)
  creator           User?           @relation("CustomerCreator", fields: [created_by_id], references: [id], onDelete: SetNull)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, customer_number])
  @@index([created_by_id])
  @@index([email])
  @@index([phone])
  @@index([organization_id])
  @@index([parent_id])
  @@index([bill_to_customer_id])
  @@map("customers")
}

model CustomerEmail {
  id              String   @id @default(uuid()) @db.Uuid
  customer_id     String   @db.Uuid
  email           String   @db.VarChar(255)
  label           String?  @db.VarChar(50)
  // Does this secondary address receive the org's AUTOMATED customer mail (Automation
  // Center: walkthrough confirmation/reminder, job scheduled, ...)? The scalar
  // Customer.email always receives and has no equivalent flag. Manual sends (Send
  // Estimate / Send Invoice) still target the primary only — deliberately out of scope.
  // Defaults true so an address added from now on receives, matching the intent of
  // adding it; the migration backfills every PRE-EXISTING row to false so no live org
  // starts mailing an address nobody opted in. -> services/automations/recipients.ts
  receives_emails Boolean  @default(true)
  created_at      DateTime @default(now())
  customer        Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@map("customer_emails")
}

// Entity-redesign §2: 1+ phones per customer (label + extension). Reached via the
// parent Customer (already tenant-scoped) — no organization_id, mirrors CustomerEmail.
model CustomerPhone {
  id          String   @id @default(uuid()) @db.Uuid
  customer_id String   @db.Uuid
  phone       String
  label       String?  @db.VarChar(50)
  extension   String?
  is_primary  Boolean  @default(false)
  created_at  DateTime @default(now())
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@map("customer_phones")
}

model ServiceLocation {
  id            String        @id @default(uuid()) @db.Uuid
  customer_id   String        @db.Uuid
  address_line1 String
  address_line2 String?
  city          String
  state         String
  zip           String
  is_primary    Boolean       @default(false)
  created_at    DateTime      @default(now())
  // --- Entity-redesign §10: archive instead of delete when referenced ---
  is_active     Boolean       @default(true)
  archived_at   DateTime?
  jobs          Job[]
  leads         Lead[]
  service_plans ServicePlan[]
  // R6 (2026-07-22) — direct anchor mirroring Job.service_location_id; see Estimate.service_location_id.
  estimates     Estimate[]
  customer      Customer      @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@map("service_locations")
}

model Lead {
  id                             String            @id @default(uuid()) @db.Uuid
  lead_number                    String
  // Editable record IDs (Workiz dual-run) — see numbering.ts self-heal + rename transaction.
  number_is_custom               Boolean           @default(false)
  original_number                String?
  estimate_seq                   Int               @default(0) // SERV10X-61 - per-lead estimate container counter (L00005-1)
  customer_id                    String            @db.Uuid
  status                         LeadStatus        @default(NEW)
  service_request                String
  // --- Lead stage clocks (spec #1751) --------------------------------------------------------
  // `contacted_at` predates them and keeps its name and its meaning: the FIRST human-originated
  // outbound touch. D5 finally gives it writers - until then the only writer anywhere in the
  // product was the demo seeder, which is why the dashboard's "needs follow-up" tile equals the
  // open-lead count on every real org.
  contacted_at                   DateTime?
  contacted_note                 String?
  // Who set contacted_at BY HAND, null when the automatic detection set it. D5 ratifies a human
  // correction door, and an anonymous correction is not auditable.
  //
  // The relation is DECLARED, not merely implied by the column. The migration creates a real
  // `leads_contacted_set_by_fkey` -> users(id) ON DELETE SET NULL; a bare scalar here would leave
  // the schema and the catalog disagreeing, and the next `prisma migrate diff` would emit a DROP
  // CONSTRAINT for a foreign key nobody asked to remove. `prisma migrate status` cannot catch
  // that — it compares the ledger to the migrations directory, never the schema to the catalog.
  // Same shape as created_by_id / creator below, onDelete: SetNull included: deleting a user must
  // not delete the lead, only forget who made the correction. No @@index, deliberately — nothing
  // queries leads BY this column, and adding one would put the schema and the migration out of
  // sync in the other direction.
  contacted_set_by               String?           @db.Uuid
  contact_setter                 User?             @relation("LeadContactSetter", fields: [contacted_set_by], references: [id], onDelete: SetNull)
  // D3, the central decision: there are THREE different questions about walkthrough completion,
  // so there are three different fields. One field cannot answer all three without lying to two.
  //
  //   "did this lead ever finish one?"     -> walkthrough_first_completed_at  (MONOTONIC)
  //   "is the phase open right now?"       -> NOBODY ASKS - see below
  //   "is anything outstanding as of now?" -> last_visit_completed_at         (RE-ANCHORS)
  //
  // The middle question was to be answered by asking a person ("are more visits needed?") each
  // time a trip finished. The product owner rejected that: at the moment a trip ends the
  // salesperson usually does not yet know, so the prompt collects a guess and the SLA is then
  // anchored on the guess. The phase is therefore never declared closed at all, and the estimate
  // clock counts from last_visit_completed_at, which every completion re-anchors.
  //
  // Deliberately NOT named walkthrough_scheduled_at / walkthrough_completed_at: the legacy
  // projection (services/walkthrough.service.ts) already puts those two WIRE keys on the lead,
  // derived from the lead's CURRENT visit, and the current-visit rule prefers any live visit
  // over a finished one. Booking a second visit flips that projection's completion back to null
  // - correct for a page hero, unusable as the anchor of an SLA. Reusing the names would collide.
  //
  // BOOKED, not SCHEDULED, and the distinction is the whole measurement. This is the instant the
  // booking ACTION happened, not the instant the walkthrough is due to happen. The owner's policy
  // is "every lead gets a walkthrough BOOKED within a day or two of first contact", so the clock
  // has to stop when the salesperson booked it - an appointment set for three weeks out was still
  // booked on time. Naming it `..._scheduled_at` would read as the appointment instant, which is
  // what the legacy wire key of that name already means.
  walkthrough_first_booked_at    DateTime?
  // MONOTONIC. Set once, on the first completion, and never cleared or overwritten - not when a
  // later visit is booked, not when every visit is cancelled. A deadline that was missed stays
  // missed; booking a late visit must not erase evidence that the company was late (ratified by
  // the product owner). This is the funnel's "furthest stage reached" high-water mark.
  //
  // NOTHING READS THIS YET, and that is deliberate rather than a leftover. It is the only durable
  // record of when site work first happened - last_visit_completed_at overwrites that on the
  // second trip - so the funnel report D10 builds needs it, and it costs one nullable timestamp
  // to keep the fact rather than reconstruct it later from visit rows that may have been
  // cancelled since. It is a ledger column by intent. It is NOT the SLA anchor; see below.
  walkthrough_first_completed_at DateTime?
  // RE-ANCHORS: MAX(completed_at) over the lead's non-cancelled visits, rewritten on every
  // completion. Answers "is there anything outstanding right now", which is what alerting needs
  // and what the monotonic field above deliberately cannot say. Same name and same maintenance
  // rule as the JOB side's mirror (multi-visit slice S8) - the same idea applied to the other
  // parent of the same `visits` table.
  //
  // THE SLA ANCHOR for "walkthrough done -> estimate sent" (services/automations/anchors.ts,
  // key `lead.last_visit_completed_at`). Because the automation engine keys an occurrence on the
  // anchor's own value, moving this column mints a NEW occurrence: a second completed trip
  // supersedes the alert still pending from the first rather than letting it fire against a
  // deadline the business has stopped holding anyone to. Only a COMPLETION moves it - a visit
  // that is booked, moved or cancelled does not - so removing a trip that turned out to be
  // unnecessary costs nothing, and no clock ever depends on a visit that has not happened yet.
  last_visit_completed_at        DateTime?
  // First touch only. A resend, or a second estimate on the same lead, must not move it: the
  // owner's metric is "how long until the salesperson sent an estimate", asked once.
  first_estimate_sent_at         DateTime?
  // The lead-side twin of lost_at / cancelled_at, which already exist. Its absence is why
  // time-to-close is inferred today from `updated_at`, a value any unrelated edit moves.
  won_at                         DateTime?
  notes                          String?
  lost_at                        DateTime?
  lost_reason                    String?
  cancelled_at                   DateTime?
  cancelled_reason               String?
  created_at                     DateTime          @default(now())
  updated_at                     DateTime          @updatedAt
  job_type                       String?
  source                         String?
  scheduled_end                  DateTime?
  scheduled_start                DateTime?
  // --- Entity-redesign §3: lead anchored to one ServiceLocation. service_address_* below are @deprecated — backfilled into ServiceLocation, then dropped in Phase D ---
  service_location_id            String?           @db.Uuid
  service_address_line1          String?
  service_address_line2          String?
  service_city                   String?
  service_state                  String?
  service_zip                    String?
  // --- Custom Fields (SRVW-114): { "<definition-uuid>": <scalar> } ---
  custom_fields                  Json              @default("{}")
  estimates                      Estimate[]
  call_sessions                  CallSession[]     @relation("LeadCallSessions")
  message_threads                MessageThread[]   @relation("LeadMessageThreads")
  messages                       Message[]         @relation("LeadMessages")
  whatsapp_chats                 WhatsAppChat[]    @relation("LeadWhatsAppChats")
  whatsapp_messages              WhatsAppMessage[] @relation("LeadWhatsAppMessages")
  emails                         Email[]           @relation("LeadEmails")
  lead_tags                      LeadTag[]
  customer                       Customer          @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  service_location               ServiceLocation?  @relation(fields: [service_location_id], references: [id])

  // --- Scheduler redesign: assignment M2M spine (legacy assigned_to/walkthrough_assigned_to dropped in TG7) ---
  commission_owner_id String?         @db.Uuid
  commission_owner    User?           @relation("LeadCommissionOwner", fields: [commission_owner_id], references: [id])
  lead_assignees      LeadAssignee[]
  // --- Logistic Orders ---
  logistic_orders     LogisticOrder[] @relation("LogisticOrderLead")

  // --- Multi-visit S1: a lead holds MANY live visits (purpose WALKTHROUGH) ---
  visits Visit[]

  // --- Creator tracking (audit only). NOTHING reads these for authorization. ---
  // Immutable, written once at create. Same shape and rationale as Job - see that model. Distinct
  // from commission_owner_id above: the owner is reassignable and is about responsibility, this is
  // an unchanging record of who first made the row.
  // -> md_files/specs/permissions/2026-08-04-technician-ownership-and-creator-tracking.md (Part A)
  created_by_id     String?         @db.Uuid
  created_by_name   String?
  created_by_source CreatedBySource @default(UNKNOWN)
  creator           User?           @relation("LeadCreator", fields: [created_by_id], references: [id], onDelete: SetNull)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, lead_number])
  @@index([created_by_id])
  @@index([status])
  @@index([customer_id])
  @@index([service_location_id])
  @@index([commission_owner_id])
  @@index([organization_id])
  // The date-anchor sweep runs every minute, per org, per registered anchor, and selects on
  // exactly these pairs. Without them each tick is a full scan of `leads` per automation.
  @@index([organization_id, created_at])
  @@index([organization_id, contacted_at])
  // last_visit_completed_at, not walkthrough_first_completed_at: the estimate SLA anchors on the
  // re-anchoring clock, so that is the column candidatesForAnchor sweeps once a minute per org.
  @@index([organization_id, last_visit_completed_at])
  @@map("leads")
}

// Multi-visit spec (md_files/specs/scheduling/2026-08-17-multi-visit.md), slice S1.
//
// A VISIT is one occurrence of people going to a site, for either purpose. It belongs to exactly
// one parent - a Lead (purpose WALKTHROUGH) or a Job (purpose WORK) - and carries a time, a crew,
// a status and notes. It never carries money, an address of its own, or a signature: the invoice,
// the estimate and the deposit stay anchored on the Job (D4). That boundary is what keeps the
// declined Projects grouping (SRVW-181) declined rather than reopened by accident.
//
// This is the renamed and widened `walkthroughs` table. D5: ONE table with nullable job_id and
// lead_id plus a DB CHECK that exactly one is set - NOT a polymorphic parent_type/parent_id pair,
// which would give up FK integrity and cascade and make the tenant-scoping joins painful.
//
// S1 populates the lead side only; job_id stays unwritten until slice S2. The column and its CHECK
// land now so the unified table is real from day one rather than a promise - running two parallel
// visit implementations for weeks is exactly the drift #1551 spent a PR undoing.
//
// (The previous comment here claimed nothing read this table. That was stale from PR-A2: five
// controllers and the visit service read it. Fixed while renaming, per the spec's open items.)
model Visit {
  id                     String       @id @default(uuid()) @db.Uuid
  organization_id        String       @db.Uuid
  // Exactly one of the two is set - enforced by a DB CHECK (see the S1 migration), which Prisma
  // cannot express. Both are nullable here so the client type allows either parent.
  lead_id                String?      @db.Uuid
  job_id                 String?      @db.Uuid
  // Derivable from whichever parent is set; stored for query clarity and so a visit can be
  // filtered by purpose without joining its parent.
  purpose                VisitPurpose
  // D13: stable per-parent creation-order number, driving the "Visit 2" label. Mirrors the
  // existing J00007-1 estimate-sequence idiom. Sort by TIME everywhere, label by CREATION order -
  // this number appears in customer email, so renumbering when an earlier trip is inserted would
  // rewrite history the customer has already received.
  visit_seq              Int          @default(1)
  status                 VisitStatus  @default(SCHEDULED)
  // The start of the visit. Named `scheduled_at` because that is the column S1 inherited from the
  // walkthrough shape; renaming it to `scheduled_start` is a pure cross-tree sweep with no
  // behaviour change (lead side, projectLegacyWalkthroughFields, frontend/src/lib/visits.ts) and
  // belongs with S8's tidy.
  scheduled_at           DateTime?
  // S2: a job's schedule is a WINDOW plus an all-day flag, which the walkthrough shape had no way
  // to hold - a lead walkthrough never had an end or an all-day concept. Without these two,
  // Job.is_all_day has nowhere to live and the end has to be re-derived from a duration, so every
  // all-day job would round-trip to a 60-minute one on the first visit-driven write.
  scheduled_end          DateTime?
  is_all_day             Boolean      @default(false)
  // Kept alongside scheduled_end: the lead-shaped readers and detectPerformerConflicts still
  // reason in minutes. Every S2 write sets both from the same span.
  duration_minutes       Int?
  // S4 (D7): the milestone stamps move to the VISIT - a trip is what is en route, on site and
  // under way, not the job. Job.en_route_at / on_site_at / started_at stay as a mirror of the
  // earliest non-null across the set. S5 repointed the lifecycle bar off en_route_at and
  // on_site_at, so those two now have NO reader anywhere; their DROP is S8's. started_at is NOT
  // symmetric and must survive S8: deriveJobStatusFromVisits opens with
  // `if (jobStartedAt != null) return 'IN_PROGRESS'` for the urgent workflow, and complete()
  // backfills it so duration reporting never sees a null start.
  en_route_at            DateTime?
  on_site_at             DateTime?
  started_at             DateTime?
  completed_at           DateTime?
  notes                  String?
  cancelled_at           DateTime?
  cancelled_reason       String?
  cancelled_by           String?      @db.Uuid
  customer_email_sent_at DateTime?
  created_at             DateTime     @default(now())
  updated_at             DateTime     @updatedAt

  lead         Lead?           @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  job          Job?            @relation(fields: [job_id], references: [id], onDelete: Cascade)
  canceller    User?           @relation("VisitCancelledBy", fields: [cancelled_by], references: [id], onDelete: SetNull)
  organization Organization    @relation(fields: [organization_id], references: [id])
  assignees    VisitAssignee[]

  // D13 - the number ships in the customer's email subject, so it has to be unique per
  // parent. NULLs compare distinct in a Postgres unique index, so each of these
  // constrains only the rows that actually have that parent - the same split
  // visits_exactly_one_parent already enforces (section 4.4 of the multi-visit QA run).
  @@unique([job_id, visit_seq])
  @@unique([lead_id, visit_seq])
  @@index([lead_id])
  @@index([job_id])
  @@index([organization_id])
  @@index([organization_id, status])
  // Multi-visit S6: the board's date window is a relation filter on this column now, not on the
  // `Job.scheduled_start` mirror. Prisma renders it as an uncorrelated `job_id IN (SELECT ...)`
  // whose only selective predicate is `scheduled_at`, so without this index the planner drives
  // from `jobs` and nested-loops every candidate row (41x slower / 350x the I/O on staging).
  @@index([scheduled_at])
  @@map("visits")
}

model Estimate {
  id                     String                    @id @default(uuid()) @db.Uuid
  // R6 (2026-07-22) — M5: lead_id relaxed to optional; customer_id/service_location_id added,
  // mirroring Job's own anchor shape exactly (Job.customer_id/service_location_id,
  // schema.prisma ~663-664). Backend-foundation-only stage: no create-time UI path exists yet
  // for a lead-less estimate — create()/duplicate()/revise() denormalize these two columns
  // from the lead at write time so every row (past and future, as long as creation stays
  // lead-anchored) has them populated. service_location_id stays nullable (unlike Job's
  // required column) because ~54% of existing leads have no ServiceLocation row yet (still on
  // the legacy service_address_* fields) — backfill coverage is incomplete, verified on staging.
  lead_id                String?                   @db.Uuid
  customer_id            String                    @db.Uuid
  service_location_id    String?                   @db.Uuid
  // R6 — M4: mirrors Job.estimate_id in the reverse direction (which estimate a job was
  // created from). Backfilled once from Job.estimate_id, then kept in sync at the one write
  // site (job.controller.ts create()) whenever a job's single-estimate provenance is set. Not
  // @unique: a future multi-estimate-per-job design (SERV10X-61) may want more than one estimate
  // pointing at the same job — no need to foreclose that here.
  job_id                 String?                   @db.Uuid
  estimate_number        String
  // Editable record IDs (Workiz dual-run) — see numbering.ts self-heal + rename transaction.
  number_is_custom       Boolean                   @default(false)
  original_number        String?
  // Which container minted this estimate's number and this estimate's seq WITHIN that
  // container (SERV10X-61's `estimate_seq` lives on the parent row, not here). Nullable: a
  // legacy flat `E00001` number or a bare Workiz-imported number has no container. Backfilled
  // once by scripts/estimate-container-backfill.ts for every existing container-style number
  // (`<container_number>-<seq>`); set going forward at create time (step 2) and never re-derived
  // by string-matching again — see "Why the estimate columns are mandatory" in the plan.
  container_kind         EstimateContainerKind?
  container_seq          Int?
  status                 EstimateStatus            @default(DRAFT)
  sent_at                DateTime?
  approved_at            DateTime?
  declined_at            DateTime?
  expired_at             DateTime?
  cancelled_at           DateTime?
  cancelled_reason       String?
  voided_at              DateTime?
  voided_reason          String?
  scope_notes            String?
  scopes                 Json?
  subtotal               Decimal                   @db.Decimal(12, 2)
  tax_amount             Decimal                   @db.Decimal(12, 2)
  total_amount           Decimal                   @db.Decimal(12, 2)
  public_token           String?                   @unique
  created_by             String                    @db.Uuid
  created_at             DateTime                  @default(now())
  updated_at             DateTime                  @updatedAt
  // R5c (2026-07-22) -- widened 5,4 -> 6,5: MN/MO/NJ/NM's real combined rates (6.875%/4.225%/
  // 6.625%/5.125%) need a 5th decimal place; (5,4) rounds them at the door.
  tax_rate               Decimal                   @default(0) @db.Decimal(6, 5)
  discount_type          DiscountType?
  discount_value         Decimal?                  @db.Decimal(12, 2)
  discount_name          String?
  discount_amount        Decimal                   @default(0) @db.Decimal(12, 2)
  signature_data         String?
  signature_ip           String?
  signature_at           DateTime?
  terms_accepted         Boolean                   @default(false) // #21 — server-enforced T&C acknowledgment
  terms_accepted_at      DateTime? // #21 — set together with terms_accepted
  valid_until            DateTime?
  snapshot_terms         String?                   @db.Text
  snapshot_notes         String?                   @db.Text
  snapshot_payment_terms String?                   @db.Text
  // ── S1 reporting fields (nullable; see report.controller.ts) ──
  lead_source            String?
  job_type               String?
  lost_reason            LostReason?
  // ── Estimate workspace redesign (2026-07-03) ──
  name                   String?
  version                Int                       @default(1)
  modified_after_send    Boolean                   @default(false)
  superseded_by_id       String?                   @unique @db.Uuid
  deposit_type           DepositDefaultType?
  deposit_value          Decimal?                  @db.Decimal(12, 2)
  // R3 (2026-07-21) — cost model: labor hours + a per-estimate overhead override (D2/D8/D18).
  // Nullable override mirrors deposit_type/deposit_value directly above: null = fall back to the
  // org default (Organization.overhead_mode/overhead_value). Cost/margin math itself is computed
  // on read (frontend), not persisted — these three columns are the only new state.
  labor_hours            Decimal?                  @db.Decimal(8, 2)
  overhead_mode          DepositDefaultType?
  overhead_value         Decimal?                  @db.Decimal(12, 2)
  scope_name             String?
  send_config            EstimateSendConfig?
  line_items             EstimateLineItem[]
  // R5f (2026-07-22) — scope-of-work photos. Estimate.scopes is a JSONB array with no relational
  // row per scope block, so this side carries the FK (compound estimate_id+scope_id match is
  // required at every read/write site — see EstimateScopePhoto's own comment).
  scope_photos           EstimateScopePhoto[]
  version_snapshots      EstimateVersionSnapshot[]
  creator                User                      @relation("EstimateCreatedBy", fields: [created_by], references: [id])
  lead                   Lead?                     @relation(fields: [lead_id], references: [id], onDelete: Restrict)
  customer               Customer                  @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  service_location       ServiceLocation?          @relation(fields: [service_location_id], references: [id])
  // "JobPrimaryEstimate" — the pre-existing 1:1 (Job.estimate_id, the job's own provenance
  // pointer, unchanged). "EstimateJobLink" — the new R6 mirror above (Estimate.job_id). Two
  // distinct relations between the same two models must both be explicitly named; this rename
  // is schema-only (the Prisma Client field names `job`/`job_link` are unaffected).
  job                    Job?                      @relation("JobPrimaryEstimate")
  job_link               Job?                      @relation("EstimateJobLink", fields: [job_id], references: [id], onDelete: SetNull)
  invoices               Invoice[]
  reservations           EstimateReservation[]
  superseded_by          Estimate?                 @relation("EstimateSupersession", fields: [superseded_by_id], references: [id])
  superseded_from        Estimate?                 @relation("EstimateSupersession")
  logistic_orders        LogisticOrder[]           @relation("LogisticOrderEstimate")

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, estimate_number])
  @@index([lead_id])
  @@index([customer_id])
  @@index([service_location_id])
  @@index([job_id])
  @@index([status])
  @@index([created_by])
  @@index([organization_id])
  @@map("estimates")
}

model EstimateVersionSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  estimate_id  String   @db.Uuid
  version      Int
  total_amount Decimal  @db.Decimal(12, 2)
  line_items   Json
  scopes       Json?
  sent_at      DateTime
  created_at   DateTime @default(now())

  estimate Estimate @relation(fields: [estimate_id], references: [id], onDelete: Cascade)

  @@index([estimate_id])
  @@map("estimate_version_snapshots")
}

model ScopePreset {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  name            String
  emoji           String?
  scope_text      String   @db.Text
  priced          Boolean  @default(false)
  price           Decimal? @db.Decimal(12, 2)
  is_taxable      Boolean  @default(true)
  internal_cost   Decimal? @db.Decimal(12, 2)
  // R5a (2026-07-21) -- free-text grouping tag, not a relational category (PriceBookCategory's
  // hierarchical parent/child model is overkill for what's typically a few dozen org presets).
  // Nullable -- an uncategorized preset is valid, just not filterable by any chip.
  category        String?  @db.VarChar(100)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@map("scope_presets")
}

model EstimateLineItem {
  id                 String                  @id @default(uuid()) @db.Uuid
  estimate_id        String                  @db.Uuid
  sequence           Int
  description        String
  quantity           Decimal                 @db.Decimal(10, 2)
  unit_price         Decimal                 @db.Decimal(12, 2)
  is_taxable         Boolean                 @default(true)
  line_total         Decimal                 @db.Decimal(12, 2)
  price_book_item_id String?                 @db.Uuid
  unit_cost          Decimal?                @db.Decimal(12, 2)
  markup_percent     Decimal?                @db.Decimal(5, 2)
  discount_type      DiscountType?
  discount_value     Decimal?                @db.Decimal(12, 2)
  discount_amount    Decimal                 @default(0) @db.Decimal(12, 2)
  item_type          PriceBookItemType       @default(SERVICE)
  estimate           Estimate                @relation(fields: [estimate_id], references: [id], onDelete: Cascade)
  price_book_item    PriceBookItem?          @relation(fields: [price_book_item_id], references: [id])
  // R5f (2026-07-22) — photos attached to this line item. Line items always get a fresh id on
  // duplicate()/revise() (unlike Estimate.scopes' JSON blocks), so onDelete: Cascade on the FK
  // alone is sufficient here — no compound key needed the way EstimateScopePhoto requires.
  photos             EstimateLineItemPhoto[]

  @@index([price_book_item_id])
  @@map("estimate_line_items")
}

// R5f (2026-07-22) — a photo attached to an EstimateLineItem. Supabase Storage (`attachments`
// bucket, same as JobStageAttachment) holds the bytes; only storage_path is persisted here — every
// read mints a fresh short-lived signed URL server-side (estimate.controller.ts's
// resolveEstimatePhotoUrls / estimate-photos.controller.ts's per-upload response), never a
// persisted signed/public URL.
model EstimateLineItemPhoto {
  id                    String   @id @default(uuid()) @db.Uuid
  estimate_line_item_id String   @db.Uuid
  storage_path          String   @db.Text
  mime_type             String
  caption               String?
  uploaded_at           DateTime
  uploaded_by           String
  size_bytes            Int?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  line_item EstimateLineItem @relation(fields: [estimate_line_item_id], references: [id], onDelete: Cascade)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([estimate_line_item_id])
  @@index([organization_id])
  @@map("estimate_line_item_photos")
}

// R5f (2026-07-22) — a photo attached to a scope-of-work block. Estimate.scopes (scopes.ts) is a
// raw JSONB array with NO relational row per scope — there is no ScopeOfWork table to hang a plain
// scope_id FK off, and duplicate()/revise() copy `scopes` VERBATIM including each block's `id`, so
// the SAME scope id can legitimately exist in two different estimates' scopes[] at once. Every
// query/lookup/delete against this model MUST filter on the COMPOUND (estimate_id, scope_id) —
// never scope_id alone — or a photo on the original estimate's scope could appear to belong to a
// duplicated/revised copy's same-id scope too. Duplicate()/revise() deliberately do NOT copy these
// rows forward — a fresh copy starts with no scope photos, which the compound key already
// guarantees without any extra code.
model EstimateScopePhoto {
  id           String   @id @default(uuid()) @db.Uuid
  estimate_id  String   @db.Uuid
  scope_id     String
  storage_path String   @db.Text
  mime_type    String
  caption      String?
  uploaded_at  DateTime
  uploaded_by  String
  size_bytes   Int?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  estimate Estimate @relation(fields: [estimate_id], references: [id], onDelete: Cascade)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([estimate_id, scope_id])
  @@index([organization_id])
  @@map("estimate_scope_photos")
}

model EstimateSendConfig {
  id                 String   @id @default(uuid()) @db.Uuid
  estimate_id        String   @unique @db.Uuid
  message_body       String?
  deposit_required   Boolean  @default(true)
  deposit_percentage Decimal  @db.Decimal(5, 2)
