// Logistic Orders §15: the plan's default materials template. Deliberately plan
// DATA, not a TEMPLATE-status LogisticOrder — a template has no number, no
// lifecycle and no anchors, and polluting the LO status enum would leak into
// every list, count and report. scheduleVisit instantiates these into one DRAFT
// LO per visit-job (instantiatePlanMaterials); template edits never retro-change
// an already-minted LO.
model ServicePlanMaterialLine {
  id              String   @id @default(uuid()) @db.Uuid
  service_plan_id String   @db.Uuid
  // Snapshots mirror LogisticOrderLine: a SetNull'd item still renders in the
  // builder with a "removed from catalog" hint, and the mint step can skip the
  // dead line while naming it in the LO's notes (§15 decision 7).
  item_id         String?  @db.Uuid
  item_sku        String
  item_name       String
  qty             Decimal  @db.Decimal(10, 2)
  position        Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  service_plan ServicePlan    @relation(fields: [service_plan_id], references: [id], onDelete: Cascade)
  item         PriceBookItem? @relation("ServicePlanMaterialLinePriceBookItem", fields: [item_id], references: [id], onDelete: SetNull)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([service_plan_id])
  @@index([organization_id])
  @@map("service_plan_material_lines")
}

model PlanVisit {
