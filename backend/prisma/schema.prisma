  from_location_id       String?  @db.Uuid
  to_location_id         String?  @db.Uuid
  reference              String
  actor                  String
  // Inventory P0 enrichment (§3.1): real refs + cost + actor. All FKs SetNull —
  // the ledger must survive item/job/line/user deletion (snapshots carry context).
  item_id                String?  @db.Uuid
  job_id                 String?  @db.Uuid
  job_line_item_id       String?  @db.Uuid
  invoice_line_item_id   String?  @db.Uuid
