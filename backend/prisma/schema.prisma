// ─── Inventory P4 (plan §4 Phase 4 / D12): company tools assigned to technicians ───
// NOT serialized sellable stock, NOT customer equipment (both deferred).

enum AssetStatus {
  ACTIVE
  RETIRED
}

enum AssetEventType {
  ASSIGNED
  RETURNED
  TRANSFERRED
  RETIRED
  NOTE
}

model Asset {
  id                 String      @id @default(uuid()) @db.Uuid
  name               String
  // NO uniqueness on serial — duplicate serials are a client-side WARN only (QA-38 default).
  serial             String?
  // Canonical Supabase Storage path in the `attachments` bucket (mirrors
  // Attachment.storage_path). API serializers mint short-lived signed URLs from
  // it — never persist a signed/public URL here, and never a data-URI
  // (JobStageAttachment.data_url anti-pattern).
  photo_url          String?     @db.Text
  price_book_item_id String?     @db.Uuid
  status             AssetStatus @default(ACTIVE)
  assigned_user_id   String?     @db.Uuid
  notes              String?     @db.Text
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  price_book_item PriceBookItem? @relation("AssetPriceBookItem", fields: [price_book_item_id], references: [id], onDelete: SetNull)
  assigned_user   User?          @relation("AssetAssignedUser", fields: [assigned_user_id], references: [id], onDelete: SetNull)
  events          AssetEvent[]

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([assigned_user_id])
  @@index([price_book_item_id])
  @@index([status])
  @@map("assets")
}

// Append-only history ledger: no update/delete endpoint ever exists for
// asset_events (same stance as stock_movements).
model AssetEvent {
  id         String         @id @default(uuid()) @db.Uuid
  asset_id   String         @db.Uuid
  type       AssetEventType
  // Counterparty tech: new holder for ASSIGNED/TRANSFERRED; releasing holder
  // for RETURNED; holder-at-retire for RETIRED; null for NOTE.
  user_id    String?        @db.Uuid
  // Actor. Written on EVERY event (controller uses req.user!.id — never null at
  // write time). Nullable + SetNull ONLY so the history survives hard user
  // deletion — the exact stock_movements.actor_user_id precedent.
  by_user_id String?        @db.Uuid
  note       String?        @db.Text
  at         DateTime       @default(now())

  asset   Asset @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  user    User? @relation("AssetEventUser", fields: [user_id], references: [id], onDelete: SetNull)
  by_user User? @relation("AssetEventByUser", fields: [by_user_id], references: [id], onDelete: SetNull)

  organization_id String       @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([asset_id, at])
  @@index([organization_id])
  @@map("asset_events")
}

model PurchaseOrder {
  id                     String    @id @default(uuid()) @db.Uuid
  po_number              String
  vendor                 String
  vendor_id              String?   @db.Uuid
  status                 String
  job_id                 String?   @db.Uuid
  customer_id            String?   @db.Uuid
  customer               String?
