# Backend environment - copy to backend/.env and fill in.
#
#   cp backend/.env.example backend/.env
#
# Every value below is a PLACEHOLDER. Real credentials are sent to you
# separately and must never be committed - backend/.env is gitignored.
#
# The schema that validates these lives in src/config/env.ts. It parses at
# import time, so a missing REQUIRED value crashes the process at boot with a
# Zod error naming the variable. That is deliberate: fail loudly, not at the
# first request.

# ---------------------------------------------------------------------------
# REQUIRED - the backend will not start without these
# ---------------------------------------------------------------------------

# Postgres via the Supabase POOLER, transaction mode (port 6543). Prisma's
# runtime connection. pgbouncer=true and connection_limit=1 are required in
# transaction mode - without them Prisma opens prepared statements the pooler
# cannot keep, and you get intermittent "prepared statement already exists".
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Same database, pooler SESSION mode (port 5432). Used ONLY by prisma migrate
# and prisma db push - migrations need a session-mode connection and fail on
# the transaction-mode port. Note the different port and no pgbouncer flag.
# The non-pooler direct host (db.PROJECTREF.supabase.co) is IPv6-only, so it is
# unreachable from most home/office networks. Use the pooler host here.
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

SUPABASE_URL="https://PROJECTREF.supabase.co"

# Service-role key. BYPASSES row-level security entirely - it is a full-database
# credential. Server-side only: never put it in frontend code, a VITE_ variable,
# or anything that reaches the browser bundle.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Where the frontend runs. Used for links in outbound email and for CORS.
FRONTEND_URL="http://localhost:5173"

# Comma-separated extra origins allowed by CORS. Add your Vercel URL once the
# frontend is deployed, e.g. "http://localhost:5173,https://your-app.vercel.app"
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# Default sales-tax rate when an org has not configured its own (0.0875 = 8.75%).
TAX_RATE=0.0875

# Anon/publishable key. Optional here - the backend does not need it, the
# frontend does. Kept for parity with deployed environments.
SUPABASE_ANON_KEY="your-anon-publishable-key"

# ---------------------------------------------------------------------------
# Secrets you generate yourself
# ---------------------------------------------------------------------------
# Optional in development (both fall back to SUPABASE_SERVICE_ROLE_KEY), but
# REQUIRED at >=32 chars in production - the app refuses to boot without them.
# They are separate from the service-role key on purpose: a service-role leak
# must not also grant OTP forgery or invite-link minting, and each must rotate
# independently.
#
#   INVITE_TOKEN_SECRET   openssl rand -hex 32
#   MFA_TOKEN_ENC_KEY     openssl rand -base64 32

INVITE_TOKEN_SECRET=""
MFA_TOKEN_ENC_KEY=""

# DO NOT SET ORIGIN_VERIFY_SECRET here.
# It enables a gate that rejects any request which did not arrive through
# Cloudflare. There is no Cloudflare in front of this environment, so setting
# it makes every API call return 403 - including login. It is intentionally
# absent, not forgotten.

# ---------------------------------------------------------------------------
# Email (Resend) - optional
# ---------------------------------------------------------------------------
# Without a key, mail is not sent: lib/email.ts logs the message instead. That
# also disables email-OTP 2FA, so do not enrol an account in 2FA until this is
# set or you will lock yourself out.
# Create your own free Resend account and key.
RESEND_API_KEY=""

# Senders. Deliberately different domains: EMAIL_FROM carries auth mail (login
# codes, invites) and its reputation must never depend on customer sending
# volume, while EMAIL_FROM_BUSINESS carries customer-facing mail. Both must be
# on a domain verified in YOUR Resend account or Resend 403s the send.
EMAIL_FROM="no-reply@example.com"
EMAIL_FROM_BUSINESS="no-reply@mail.example.com"

# Inbound catch-all domain. Reply addresses are <token>@ this domain. Only
# needed if you wire up inbound email; requires MX pointed at Resend.
EMAIL_REPLY_DOMAIN="reply.example.com"

# Resend delivery-webhook signing secret (from the Resend dashboard - a svix
# secret, NOT the API key). The webhook route fails CLOSED when unset, so
# unverified payloads are rejected rather than silently trusted.
RESEND_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Stripe - optional, test mode only
# ---------------------------------------------------------------------------
# Use your own account and stay in test mode. Test card: 4242 4242 4242 4242,
# any future expiry, any CVC.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_WEBHOOK_SECRET_CONNECT=""

# ---------------------------------------------------------------------------
# CallTrackingMetrics (phone / SMS) - NOT configured in this environment
# ---------------------------------------------------------------------------
# No CTM account is attached. Calls, SMS, WhatsApp and the softphone return 402
# or render empty - expected, not a bug. Enabling it needs a paid subaccount and
# a purchased number, so ask before starting work here.
CTM_ACCESS_KEY=""
CTM_SECRET_KEY=""
CTM_WEBHOOK_TOKEN=""
CTM_WEBHOOK_SIGNING_SECRET=""
CTM_API_BASE=""
CTM_RECORDINGS_BUCKET="call-recordings"

# This backend's own public origin, used to build the webhook URL CTM calls
# back on. Note this is the BACKEND origin - FRONTEND_URL is the wrong value.
BACKEND_PUBLIC_URL="http://localhost:3000"

# Comma-separated E.164 allowlist. When set, outbound SMS/calls may go ONLY to
# these numbers - a guard against a test blasting real phones. Unset means
# unrestricted, so prefer setting it if you ever enable CTM.
CTM_OUTBOUND_ALLOWLIST=""

# ---------------------------------------------------------------------------
# Copilot ("Servy") - optional
# ---------------------------------------------------------------------------
# The assistant's brain is swappable. /api/copilot/generate returns 503 until
# the selected provider has a credential, so the app boots fine without one.
#   groq   - free OpenAI-compatible API, needs GROQ_API_KEY (default)
#   gemini - needs GEMINI_API_KEY; also powers speech-to-text and live voice
#   codex  - uses a local ~/.codex/auth.json, no key here
BRAIN_PROVIDER="groq"
GROQ_API_KEY=""
GEMINI_API_KEY=""

# ---------------------------------------------------------------------------
# Redis - optional
# ---------------------------------------------------------------------------
# Rate limiting falls back to in-memory when unset, which is fine for a single
# local process but does not share counters across instances.
REDIS_URL=""

# ---------------------------------------------------------------------------
# Sentry - optional
# ---------------------------------------------------------------------------
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# ---------------------------------------------------------------------------
# Seeding and tests
# ---------------------------------------------------------------------------
# The demo seed WIPES its target org's CRM rows before reseeding, so it refuses
# to run unless this is true. The npm script sets it; leave the guard alone.
# SEED_DEMO=true

# Overrides the default password for the ServWave Demo Two admin account.
# DEMO_TWO_ADMIN_PASSWORD=""

# Separate database for integration tests. Never point this at a database whose
# contents you care about - the suite truncates tables.
# TEST_DATABASE_URL=""

# Opt-in test groups, off by default because they are slow or need real
# infrastructure.
# RUN_INTEGRATION_TESTS=true
# RUN_ANON_LOCKOUT_TEST=true

# E2E test doors (provisioning/teardown routes). NEVER set in production - the
# whole /api/test block is skipped when NODE_ENV=production and the app refuses
# to boot if it leaks.
# E2E_TEST_DOORS=true
# E2E_ALLOWED_DB_HOSTS=""
# E2E_ALLOWED_DB_REF=""
