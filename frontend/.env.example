# Frontend environment - copy to frontend/.env and fill in.
#
#   cp frontend/.env.example frontend/.env
#
# Every value below is a PLACEHOLDER. frontend/.env is gitignored.
#
# IMPORTANT: Vite inlines every VITE_* variable into the JavaScript bundle that
# ships to the browser. Treat all of them as PUBLIC. Never put a service-role
# key, a Stripe secret key, or any other server credential behind a VITE_
# prefix - it would be readable by anyone who opens devtools.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Where the backend is. Point at the deployed API if you are not running the
# backend locally - the hosted database is already migrated and seeded, so this
# alone is enough to log in and click around.
VITE_API_URL="http://localhost:3000"
# VITE_API_URL="https://your-api.onrender.com"

VITE_SUPABASE_URL="https://PROJECTREF.supabase.co"

# The ANON / publishable key - the one safe to ship to a browser. RLS is what
# constrains it. Never the service-role key.
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Stripe publishable key, test mode (pk_test_...). Use your own account. The
# secret key belongs in backend/.env, never here.
VITE_STRIPE_PUBLISHABLE_KEY=""

# Address autocomplete. Unset by default: the address field degrades to a plain
# text input and nothing else changes. Create your own key if you want it.
VITE_GOOGLE_MAPS_API_KEY=""

# Sentry. The SDK disables itself when this is unset, so dev and CI builds send
# nothing.
VITE_SENTRY_DSN=""

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------

# Serve the dashboard from local mock data instead of the API. Useful for
# offline UI work; leave off to see real seeded data.
# VITE_DASHBOARD_USE_MOCK=true

# Redirect legacy routes to their v2 counterparts where one exists.
# VITE_UI_V2=true

# Comma-separated org-id allowlist for the Communication module, overriding the
# built-in default. The default list holds production org ids that do not exist
# in this database, so Communication stays locked here unless you add
# ServWave Demo One: 00000000-0000-0000-0000-000000000001
# VITE_COMMUNICATION_ALLOWED_ORG_IDS="00000000-0000-0000-0000-000000000001"
